FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// (luis) Originally from TPF CoffeePot example, for the coupling BC all in the example defined additional values were unnecessary to run the case and this minimal setup is left.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;		//(luis) Given by experimental data in Kelvin!

boundaryField
{

    solidTop		//solid_to_fluid	//(luis): lower boundary is differently defined in blockMesh!
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;	//luis: coupling BC between solid and fluid domain, only one alternative exists!
        value           uniform 298.15; //apparently this is an intial temp in K, and should match the temp of the field where it is defined? -> so here solid temp...?
        Tnbr            T;
        kappaMethod     solidThermo;
    }

    solidMantle
    {
	type zeroGradient;
    }

    solidBottom
    {
	type zeroGradient;
    }

}

