FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//Uses codeStream to initialize the rotation condition for the velocity
//luis: in theory here needed to be edits as well to the velocity field, since we accellerate the droplet in y-axis. The rotation is however already implemented, via codestream, only the rotational BC needs to be adapted from the previous case setup.

dimensions      [0 1 -1 0 0 0 0];
rpm			800; //200;	//@!rpm!@; <- This was a parameterization placeholder! (Other values can be 200,400, 600, 800)
omega   #eval{$rpm*2*pi()/60};	//determine angular velocity!

//from here to...
internalField   #codeStream
{
        codeInclude
        #{
            #include "fvCFD.H"
        #};

	codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
        #};

	codeLibs
        #{
            -lmeshTools \
            -lfiniteVolume
        #};

	code
  	#{
            const IOdictionary& d = static_cast<const IOdictionary&>(dict);
            const fvMesh& mesh = refCast<const fvMesh>(d.db());				 //...to here just standard codeStream lines!

            vectorField U(mesh.nCells(), Zero);						//init vectorfield with zeros

			scalar omega = $omega;
			vector axis = vector(0, 0, 1);

            forAll(U, i)								//loop through all cells
            {
				U[i] = (-omega)*(mesh.C()[i] ^ (axis/mag(axis)));	//apply omega to the meshcell value, and apply direction?
			}

            U.writeEntry("",os);							//standard write call
        #};
};


boundaryField
{
    "(fluidMantle|fluidTop)"								//BC for the hull above the plate
    {
	type    zeroGradient;
    }

    fluidBottom										//BC for the plate?/bottom of the case/domain?
    {
         //type            rotatingWallVelocity;
         //origin          (0 0 0);
         //axis            (0 0 1);
         //omega           $omega;
	type		   noSlip;		//luis: to make "solid surface and rotate the flow... instead of rotating the substrate...			//zeroGradient;
    }
}

