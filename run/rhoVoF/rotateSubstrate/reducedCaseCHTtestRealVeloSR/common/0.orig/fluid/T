FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// (luis) Originally from TwoPhaseFlow CoffeePot example case
#include "../../system/meshingDimensions"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 297.15; //(luis) Given by experimental data in Kelvin!

boundaryField
{

    fluidBottom	//fluid_to_solid	//(luis): lower boundary is differently defined in blockMesh!
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 297.15; //maybe 298.15 cause solid? -> No, cause only defines starting value of the domain you are in rn, not the coupled one!
	Tnbr            T;
        kappaMethod     fluidThermo;
    }

    "(fluidMantle|fluidTop)"
    {
        type zeroGradient;
    }

}

