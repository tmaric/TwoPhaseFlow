FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//For incompressible flow pressure becomes meaningless, if we dont have any gradients!
// --->>> NOT THE CASE ANYMORE, CHT IS COMPRESSIBLE!!!

dimensions      [1 -1 -2 0 0 0 0];

internalField	uniform 1e5; //sea level as baseline...

boundaryField
{
    fluidTop
    {
        type            totalPressure;
	p0		uniform 1e5;
        value           uniform 1e5;
    }

    fluidBottom
    {
        type            fixedFluxPressure;	//luis: setting is part of the coupling taken from CoffeePot!
    }

    fluidMantle
    {
	type 		zeroGradient; 
    }

}

