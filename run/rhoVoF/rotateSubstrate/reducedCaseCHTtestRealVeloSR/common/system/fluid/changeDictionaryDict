FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//sets up the coupling between the solidTop patch and the fluidBottom patch

dictionaryReplacement
{
    boundary
    {
        fluidBottom		//(luis): see solid changeDictionaryDict
        {
            type            mappedWall;
            inGroups        1 ( wall );
            sampleMode      nearestPatchFace;
            sampleRegion    solid;
            samplePatch     solidTop;
        }
    }
}

