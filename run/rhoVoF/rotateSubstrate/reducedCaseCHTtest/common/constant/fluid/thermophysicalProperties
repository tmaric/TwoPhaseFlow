FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//luis: Originally from TPF CoffeePot example

phases (water air);

pMin            pMin [ 1 -1 -2 0 0 0 0 ] 10000;

sigma           sigma [ 1 0 -2 0 0 0 0 ] 0.0;//0.0089004;

TMin            TMin [0 0 0 1 0 0 0] 60.0;

TMax            TMax [0 0 0 1 0 0 0] 500.0;

water
{
    type pureMovingPhaseModel;	//luis: pureStaticPhaseModel, open investigation if this too can be used?
}

air
{
    type pureMovingPhaseModel;	//luis: pureStaticPhaseModel
}

surfaceForces
{
  sigma 0.0;	//luis: should this be 0?
  surfaceTensionForceModel gradAlpha;
  accelerationForceModel gravity;
  deltaFunctionModel alphaCSF;
}


