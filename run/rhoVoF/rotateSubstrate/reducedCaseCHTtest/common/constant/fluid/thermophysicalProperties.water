FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//luis: Originally from TPF CoffeePot example

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight   18.0;
    }
    equationOfState
    {
        //R           1024;
        rho0        999.94;
        T0          275.15;
        beta        6.9e-4;	//luis: current value from Scheufler TPF, probably needs to be adapted to match our water...
    }
    thermodynamics
    {
        Cp          4210;
        Hf          0;
    }
    transport
    {
        mu          0.001674;
        Pr          4.9;
    }
}


// ************************************************************************* //
