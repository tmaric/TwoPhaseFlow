FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// (luis) Originally from TPF CoffeePot example, for the coupling BC all in the example defined additional values were unnecessary to run the case and this minimal setup is left.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 275.15; //(luis) given by experimental data in Kelvin!

boundaryField
{

    fluidBottom	//fluid_to_solid	//(luis): lower boundary is differently defined in blockMesh!
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;	//luis: siehe fluid/T
        value           uniform 275.15;
	Tnbr            T;
        kappaMethod     fluidThermo;
    }

    "(fluidTop|fluidMantle)"
    {
        type zeroGradient;
    } 

}

// ************************************************************************* //
