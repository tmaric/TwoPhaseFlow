FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// (luis) just copied from TPF

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 275.15; //(luis) given by experimental data in Kelvin!

boundaryField
{
//pretty much no BC apart from the "fluid_to_solid", auch so defined for alpha.water, donno about fluid fluid tho...
//    Sym
//    {
//        type zeroGradient;
//    }
//
    fluidBottom	//fluid_to_solid	//(luis): lower boundary is differently defined in blockMesh!
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;	//luis: siehe fluid/T
	//mode		constantMass;
        value           uniform 275.15;
	Tnbr            T;
        //thickness	0;
	//Tnbr            T;
        kappaMethod     fluidThermo;
        //qrNbr           none;
        //qr              none;
        //kappa           none;
    }

    "(fluidTop|fluidMantle)"		//(luis) apparently this cant be empty?
    {
        type zeroGradient;
    } 

//
//    top
//    {
//        type zeroGradient;
//    }
//
//    bottomEmptyFaces
//    {
//        type empty;
//    }
//
//    topEmptyFaces
//    {
//        type empty;
//    }
}

