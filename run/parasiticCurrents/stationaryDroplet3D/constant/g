FoamFile
{
    version     2.0;
    format      ascii;
    class       uniformDimensionedVectorField;
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ZERO gravity. The exact solution of a stationary droplet is then U = 0 with a
// piecewise-constant pressure, so ANY velocity that appears is parasitic.
dimensions      [0 1 -2 0 0 0 0];
value           (0 0 0);

