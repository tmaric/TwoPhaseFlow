FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "simulationParameter"

// reconstructInterface passes this whole dictionary to the scheme, so the
// scheme keywords sit at the top level (as in the curvatureSphere benchmark).
reconstructionScheme $RECONSCHEME;
iterations          10;
interpolateNormal   false;
tol                 1e-8;
relTol              0.1;
surfCellTol         1e-8;
// The plane gate asks for the alpha-positioned plane at round-off: the
// volume-matching tolerance is 1e-14 here (1e-8 in the sphere ladder).
isoFaceTol          1e-14;
vof2IsoTol          1e-8;
writeVTK            false;
wispTol             $WISPTOL;          // davof: interface cell |m_c| > wispTol V^(2/3)

reconstruction
{
    nIter           1;
    setAlphaMethod  $SETALPHAMETHOD;   // cutCellIso | cutCellImpFunc | davof
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

