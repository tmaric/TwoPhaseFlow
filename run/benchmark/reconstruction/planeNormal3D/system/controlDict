FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One reconstruction step (stopAt writeNow): reconstructInterface sets alpha1
// from initAlphaFieldDict, reconstructs, and reconstructionError writes
// postProcessing/reconstructionError/0/error.dat.

application     reconstructInterface;

startFrom       startTime;
startTime       0;
stopAt          writeNow;
endTime         4;

writeControl    adjustableRunTime;
writeInterval   0.1;
deltaT          1e-3;

purgeWrite      0;
writeFormat     ascii;
writePrecision  14;
writeCompression off;
timeFormat      general;
timePrecision   14;
graphFormat     raw;
runTimeModifiable no;

adjustTimeStep  yes;
maxCo           1e6;
maxAlphaCo      0.5;
maxDeltaT       1e6;

// ************************************************************************* //
