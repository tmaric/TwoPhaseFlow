FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "simulationParameter"

solvers
{
    "alpha.water.*"
    {
        advectionScheme      isoAdvection;
        reconstructionScheme $RECONSCHEME;

        // davof: interface cell |m_c| > wispTol V^(2/3)
        wispTol         $WISPTOL;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        // davof: the mixed normal (the fallback normal of the sliver cells
        // |m_c| < sliverTol h^2) and the source of every interface cell's
        // normal; exactNormal is the translated sphere of the exact control
        sliverNormal    $SLIVERNORMAL;
        sliverTol       $SLIVERTOL;
        normalSource    $NORMALSOURCE;
        exactNormal
        {
            functionType sphere;
            origin      ($CX $CY $CZ);
            radius      $R;
            U0          ($UX $UY $UZ);
        }
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         0;
        nAlphaBounds    3;
        clip            false;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

isoAdvector
{
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

