FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "simulationParameter"

solvers
{
    "alpha.water.*"
    {
        advectionScheme      isoAdvection;
        reconstructionScheme $RECONSCHEME;

        // davof: interface cell |m_c| > wispTol V^(2/3)
        wispTol         $WISPTOL;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        // davof: the normal model (davofNormalModel.H) and where it replaces
        // m_c (applyTo all, or check: the slivers |m_c| < sliverTol h^2 and
        // the cells deviating by more than maxAngle degrees); exactNormal
        // is the translated sphere of the exact control
        normalModel     $NORMALMODEL;
        applyTo         $APPLYTO;
        sliverTol       $SLIVERTOL;
        maxAngle        $MAXANGLE;
        // a wanted cell without a model normal: keep m_c | ringArea
        noNormalFallback $NONORMALFALLBACK;
        exactNormal
        {
            functionType sphere;
            origin      ($CX $CY $CZ);
            radius      $R;
            U0          ($UX $UY $UZ);
        }
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         0;
        nAlphaBounds    3;
        clip            false;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

isoAdvector
{
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

