FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      simulationParameter;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parameters of the sphere-translation advection benchmark, #included by
// blockMeshDict, controlDict, fvSolution, initAlphaFieldDict and
// setAlphaFieldDict; genCases.py rewrites the values line by line (KEY value;).
//
// A sphere of radius 0.15 at (0.5 0.5 0.5) in the 2 x 1 x 1 box, carried by
// the uniform velocity (1 0 0) to x = 1.5 in the end time 1 (one diameter of
// travel every 0.3). N cells across the unit height (2N along x), the time
// step Co h / |U| (Courant number CO, default 0.2; the cluster runs of
// 2026-10-13 at 0.5), fixed.
N 32;
CO 0.2;
DELTAT 0.00625;
ENDTIME 1;
R 0.15;
CX 0.5;
CY 0.5;
CZ 0.5;
UX 1;
UY 0;
UZ 0;
// davof (isoAdvection stores the face fractions) | plicRDF | isoAlpha
RECONSCHEME davof;
// davof: alpha.water and alphaf.water from initDavofFields (DAVOFMETHOD);
// setAlphaField: alpha.water from the case's setAlphaFieldDict
SETALPHAMETHOD davof;
DAVOFMETHOD quadraticFaces;
WISPTOL 1e-3;
// the davof scheme's normal model (davofNormalModel.H): cellLocal | youngs |
// plicRDF | exact | ringArea | ringFit, applied to all interface cells or
// in check mode to the slivers |m_c| < SLIVERTOL h^2 and the cells deviating
// from the model normal by more than MAXANGLE degrees
NORMALMODEL cellLocal;
APPLYTO all;
SLIVERTOL 0;
MAXANGLE 15;
// what a cell without a model normal gets: keep (m_c) | ringArea (the ring
// normal of the cell)
NONORMALFALLBACK keep;

