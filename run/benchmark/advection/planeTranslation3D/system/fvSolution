FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "simulationParameter"

solvers
{
    "alpha.water.*"
    {
        advectionScheme      isoAdvection;
        reconstructionScheme $RECONSCHEME;

        // davof: interface cell |m_c| > wispTol V^(2/3); the plane positioned
        // by alpha to isoFaceTol (1e-14 for the round-off gate, as in
        // ../../reconstruction/planeNormal3D)
        wispTol         $WISPTOL;
        isoFaceTol      1e-14;
        surfCellTol     1e-8;
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         0;
        nAlphaBounds    3;
        clip            false;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

isoAdvector
{
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

