FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//All properies are in T=25 C and P=100 kPa 
transportModel  Newtonian;
soundSpeed  343;

c0 343;
rho 1.2;
mu              [ 1 -1 -1 0 0 0 0 ] 0.0;

psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;

rho0            [ 1 -3 0 0 0 0 0 ] 1.2;

R 1.51e-3;
p0             0; //10000;
// physical properties at 20°C
rhol 998.3;
rhog 1.2;
cg 343;
cl 1480; 
kg #eval{1.0/($rhog*$cg*$cg)};
kl #eval{1.0/($rhol*$cl*$cl)};
f 40000;

PMLType		cylindrical;
L  #eval{2*$cg/$f};//0.008;
PMLMax   (#eval{5.5*$cg/$f + 5*$cg/($f*400)} #eval{5.3*$cg/$f + 5*$cg/($f*400)} 100);//(100 100 100);//(0.028995583 0.01744 100);
PMLMin  (#eval{- 5.5*$cg/$f - 5*$cg/($f*400)} #eval{-5.3*$cg/$f - 5*$cg/($f*400)} -100); 
Rmax  #eval{5.3*$cg/$f + 5*$cg/($f*400)};
Rmin #eval{3.3*$cg/$f};
origin (0 0 0);

// ************************************************************************* //
