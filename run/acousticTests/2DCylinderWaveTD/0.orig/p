FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0]; // [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    outlet
    {
          type            zeroGradient;
	  //type            acousticWaveTransmissive;
          // advectiveSpeed  343;
          value           $internalField;
    }

  /*  outlet
    {
        type            fixedValue;
        value           $internalField;
    }

    topAndBottom
    {
        type            symmetry;
    }*/

    topAndBottom
    {
        type            empty;
    }

   inlet
    {
        //type            zeroGradient;
             type            uniformFixedGradient;
             uniformGradient     cosine;
             uniformGradientCoeffs
          {
              frequency       constant 40000;
              scale           constant #eval{-1.2*2*pi()*40000};//411.6;
              level           constant 0;
          }
          value           $internalField;
    }
}


