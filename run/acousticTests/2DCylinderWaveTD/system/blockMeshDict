FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale     1;

cg 343;
f 40000;
L  #eval{$cg/$f};

R         #eval{0.3*$L}; //0.06; // Cylinder radius
x2        #eval{5.3*$L};//{ 2.38732*$R };

RsinPi4   #eval{ $R*sin(0.25*pi()) };
RsinPi4n  #eval{ -$RsinPi4 };
RcosPi4   #eval{ $R*cos(0.25*pi()) };
RcosPi4n  #eval{ -$RcosPi4 };

x2sinPi4  #eval{ $x2*sin(0.25*pi()) };
x2sinPi4n #eval{ -$x2sinPi4 };
x2cosPi4  #eval{ $x2*cos(0.25*pi()) };
x2cosPi4n #eval{ -$x2cosPi4 };

z0       #eval{-$L/50}; //-0.0075;
z1        #eval{$L/50};//0.0075;
nz        1;

gS	#eval{$L/200};

vertices 
(
	($R 0 $z0)
       ($x2 0 $z0)
        (0 $R $z0)
       (0 $x2 $z0)
        (#eval{-$R} 0 $z0)
       (#eval{-$x2} 0 $z0)
        ($R 0 $z1)
       ($x2 0 $z1)
        (0 $R $z1)
       (0 $x2 $z1)
        (#eval{-$R} 0 $z1)
       (#eval{-$x2} 0 $z1)
);


blocks
(
    hex ( 0 1 3 2 6 7 9 8) (200 320 $nz) simpleGrading (1.6 1 1) //1
    hex ( 5 4 2 3 11 10 8 9 ) (200 320 $nz) simpleGrading (0.625 1 1) //2
);

edges
(
    arc  0  2 ($RcosPi4   $RsinPi4  $z0)
    arc  2 4 ($RcosPi4n   $RsinPi4  $z0)
    arc  1  3 ($x2cosPi4  $x2sinPi4 $z0)
    arc  3  5 ($x2cosPi4n  $x2sinPi4 $z0)
    arc  6  8 ($RcosPi4   $RsinPi4  $z1)
    arc  8 10 ($RcosPi4n   $RsinPi4  $z1)
    arc  7  9 ($x2cosPi4  $x2sinPi4 $z1)
    arc  9  11 ($x2cosPi4n  $x2sinPi4 $z1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 6 8 2)
            (2 8 10 4)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (3 9 7 1)
            (11 9 3 5)
        );
    }
    topAndBottom
    {
        type empty; //symmetry;
        faces
        (
            (0 2 3 1)
            (7 9 8 6)
            (2 4 5 3)
            (8 9 11 10)
        );
    }
);


