/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1;

vertices
(
    (__X_MIN__ -__Y_HALF__ -__Z_HALF__)
    (__X_MAX__ -__Y_HALF__ -__Z_HALF__)
    (__X_MAX__  __Y_HALF__ -__Z_HALF__)
    (__X_MIN__  __Y_HALF__ -__Z_HALF__)
    (__X_MIN__ -__Y_HALF__  __Z_HALF__)
    (__X_MAX__ -__Y_HALF__  __Z_HALF__)
    (__X_MAX__  __Y_HALF__  __Z_HALF__)
    (__X_MIN__  __Y_HALF__  __Z_HALF__)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (__NX__ __NY__ __NZ__) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type patch;
        faces ((0 4 7 3));
    }
    right
    {
        type patch;
        faces ((1 2 6 5));
    }
    yMin
    {
        type empty;
        faces ((0 1 5 4));
    }
    yMax
    {
        type empty;
        faces ((3 7 6 2));
    }
    zMin
    {
        type empty;
        faces ((0 3 2 1));
    }
    zMax
    {
        type empty;
        faces ((4 5 6 7));
    }
);

mergePatchPairs
(
);
