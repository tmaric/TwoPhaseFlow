/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    "alpha.*"
    {
        nAlphaCorr      1;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         0;
        clip            false;
        cAlpha          1;
        nAlphaSubCycles 1;
        advectionScheme isoAdvection;
        reconstructionScheme plicRDF;
    }

    "P.*"
    {
        solver          petsc;
        petsc
        {
            options
            {
                ksp_type preonly;
                pc_type lu;
                pc_factor_mat_solver_type mumps;
            }
            use_petsc_residual_norm false;
            monitor_foam_residual_norm false;
            caching
            {
                matrix { update always; }
                preconditioner { update always; }
            }
        }
        tolerance 1e-12;
        relTol    0;
        maxIter   1000;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    residualControl
    {
        Pre 1e-7;
        Pim 1e-7;
    }
}

relaxationFactors
{
    fields
    {
        Pre 1.0;
        Pim 1.0;
    }
    equations
    {
        ".*" 0;
    }
}
