/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (__X_INTERFACE__ -__Y_HALF__ -__Z_HALF__) (__X_MAX__ __Y_HALF__ __Z_HALF__);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);
