#!/bin/sh
set -e
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
. ./caseParams.sh

need_cmd()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: required command  not found in PATH" >&2
        exit 1
    fi
}

ensure_solver()
{
    solverName="$1"
    solverDir="$2"
    if command -v "${solverName}" >/dev/null 2>&1; then
        return 0
    fi

    repoRoot="$(cd ../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "solver/${solverDir}"
    )
}

need_cmd blockMesh
need_cmd setFields

./Allclean
./prepareCase
restore0Dir

runApplication blockMesh
runApplication setFields

if [ "${RUN_MODE}" = "serial" ]; then
    ensure_solver acousticHelmholtzFoam acousticHelmholtzFoam
    runApplication acousticHelmholtzFoam
elif [ "${RUN_MODE}" = "serial_it" ]; then
    ensure_solver freITBCFoam freITBCFoam
    runApplication freITBCFoam
else
    echo "Error: unsupported RUN_MODE=" >&2
    echo "Valid modes: serial, serial_it" >&2
    exit 1
fi

python3 postprocess_interface.py
