#!/bin/sh
set -e
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
. ./caseParams.sh

need_cmd()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: required command  not found in PATH" >&2
        exit 1
    fi
}

ensure_solver()
{
    solverName="$1"
    solverDir="$2"
    if command -v "${solverName}" >/dev/null 2>&1; then
        return 0
    fi

    repoRoot="$(cd ../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "solver/${solverDir}"
    )
}

ensure_app()
{
    appName="$1"
    appDir="$2"
    if command -v "${appName}" >/dev/null 2>&1; then
        return 0
    fi

    repoRoot="$(cd ../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "${appDir}"
    )
}

need_cmd blockMesh
need_cmd decomposePar
need_cmd reconstructPar

./Allclean
./prepareCase
restore0Dir
rm -f 0/*.in

runApplication blockMesh
ensure_app setAlphaField apps/utilities/preProcessing/setAlphaField
runApplication setAlphaField
ensure_app setPMLFields apps/utilities/mesh/setPMLFields
runApplication setPMLFields
runApplication decomposePar -force
ensure_solver "${SOLVER}" acousticHelmholtzFoam
runParallel "${SOLVER}"
runApplication reconstructPar -latestTime

python3 postprocess_interface.py
