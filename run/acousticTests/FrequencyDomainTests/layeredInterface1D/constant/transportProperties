FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;
R               1.51e-3;
p0              0.0;

rhol            1000;
rhog            1.2;
cg              343;
cl              1500;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};

f               20000;
sigmaMax        -200000;
po              3;

PMLType         rectangle;
L               0.15;
PMLMax          (0.35 10 10);
PMLMin          (-10 -10 -10);
