/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Pim;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

f   10000;
u   0.01;
rho 1.2;

boundaryField
{
    left
    {
        type     fixedGradient;
        gradient uniform #eval{-2*pi()*$f*$rho*$u};
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
