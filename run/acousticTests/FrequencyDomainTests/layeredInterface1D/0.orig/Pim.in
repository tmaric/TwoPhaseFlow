/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Pim;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

f   __DRIVE_F__;
u   __PISTON_U__;
rho __RHOG__;

boundaryField
{
    left
    {
        type     fixedGradient;
        gradient uniform #eval{-2*pi()*$f*$rho*$u};
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
