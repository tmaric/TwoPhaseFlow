FoamFile { version 2.0; format ascii; class volScalarField; object Pre; }
dimensions [1 -1 -2 0 0 0 0];
internalField uniform 0;
boundaryField
{
    "(left|right|bottom|top)"
    {
        type codedFixedValue;
        name exactPlaneWavePre;
        code
        #{
            const vectorField& cf = this->patch().Cf();
            scalarField value(cf.size());
            forAll(value, facei)
            {
                value[facei] = __P0__*cos(__PHASE__ - __KX__*cf[facei].x() - __KY__*cf[facei].y());
            }
            operator==(value);
        #};
        value uniform 0;
    }
    front { type empty; }
    back { type empty; }
}

