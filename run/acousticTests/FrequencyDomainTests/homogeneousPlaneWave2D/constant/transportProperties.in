FoamFile { version 2.0; format ascii; class dictionary; location "constant"; object transportProperties; }
transportModel Newtonian;
mu [1 -1 -1 0 0 0 0] 0;
psi [0 -2 2 0 0 0 0] 0;
rho0 [1 -3 0 0 0 0 0] __RHO0__;
R 0;
p0 0;
rhol __RHO0__;
rhog __RHO0__;
cg __C0__;
cl __C0__;
kg #eval{1.0/($rhog*$cg*$cg)};
kl #eval{1.0/($rhol*$cl*$cl)};
f __DRIVE_F__;
sigmaMax 0;
po 3;
PMLType rectangle;
L 0.1;
PMLMax (__LX__ __LY__ 1);
PMLMin (0 0 -1);

