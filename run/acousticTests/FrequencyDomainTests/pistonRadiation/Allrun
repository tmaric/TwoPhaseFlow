#!/bin/sh
set -e
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
. ./caseParams.sh                                   # Case parameters (includes RUN_MODE)
#------------------------------------------------------------------------------

need_cmd()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: required command '$1' not found in PATH" >&2
        exit 1
    fi
}

ensure_solver()
{
    solverName="$1"
    solverDir="$2"
    if command -v "${solverName}" >/dev/null 2>&1; then
        return 0
    fi

    echo "Solver '${solverName}' not found, building ${solverDir} ..."
    repoRoot="$(cd ../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "solver/${solverDir}"
    )

    if ! command -v "${solverName}" >/dev/null 2>&1; then
        echo "Error: solver '${solverName}' is still unavailable after build." >&2
        exit 1
    fi
}

# Quick switch:
#   RUN_MODE=serial ./Allrun      -> acousticHelmholtzFoam (reference)
#   RUN_MODE=serial_it ./Allrun   -> freITBCFoam (iterative PETSc)
#   RUN_MODE=mpi ./Allrun      -> freBCMFoam on decomposed case
# Optional for mpi:
#   NPROCS=<n> RUN_MODE=mpi ./Allrun
: "${RUN_MODE:=serial}"
need_cmd gmsh

if [ "${RUN_MODE}" = "mpi" ]; then
    if [ -z "${NPROCS:-}" ]; then
        NPROCS="$(awk '/^[[:space:]]*numberOfSubdomains[[:space:]]+/ {gsub(/;/, "", $2); print $2; exit}' system/decomposeParDict)"
    fi
    : "${NPROCS:=8}"
fi

./Allclean
./prepareCase
restore0Dir

gmsh -0 constant/pistonRadiation.geo
runApplication gmshToFoam  constant/pistonRadiation.msh
rm constant/pistonRadiation.msh

runApplication topoSet
runApplication createPatch -overwrite
runApplication changeDictionary -dict system/changeDictionaryDict

if [ "${RUN_MODE}" = "mpi" ]; then
    ensure_solver freBCMFoam freBCMFoam
    runApplication decomposePar -force
    runParallel freBCMFoam
    runApplication reconstructPar -latestTime
elif [ "${RUN_MODE}" = "serial" ]; then
    ensure_solver acousticHelmholtzFoam acousticHelmholtzFoam
    runApplication acousticHelmholtzFoam
elif [ "${RUN_MODE}" = "serial_it" ]; then
    ensure_solver freITBCFoam freITBCFoam
    runApplication freITBCFoam
else
    echo "Error: unsupported RUN_MODE='${RUN_MODE}'." >&2
    echo "Valid modes: serial, serial_it, mpi." >&2
    exit 1
fi

python3 postprocess_compare.py 
#------------------------------------------------------------------------------
