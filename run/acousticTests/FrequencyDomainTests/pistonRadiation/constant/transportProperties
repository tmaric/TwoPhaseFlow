FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid properties (air, 25 C)
transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;
R               1.51e-3;
p0              0.0;

rhol            998.3;                  // fluid density
rhog            1.2;                  // air density
cg              343;                    // air sound speed
cl              1480;                    // water sound speed
kg              #eval{1.0/($rhog*$cg*$cg)}; // air compressibility
kl              #eval{1.0/($rhol*$cl*$cl)}; // water compressibility

f               10000;               // Driven frequency
sigmaMax        3000;             // [1/s] PML peak damping
po              3;                    // polynomial order
cellsPerLambda  60;
wl              #eval{$cg/$f};             // wavelength
cellSize        #eval{$wl/$cellsPerLambda};

PMLType         spherical;
L               0.08;                 // PML thickness
origin          (0 0 0);                   // origin of sphere
Rmin            0.2;              // inner radius of PML
Rmax            #eval{$Rmin + $L};         // outer radius of PML

// ************************************************************************* //
