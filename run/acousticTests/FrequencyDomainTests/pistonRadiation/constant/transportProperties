FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid properties (air, 25 C)
transportModel  Newtonian;
soundSpeed      343;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;

R               1.51e-3;
p0              0.0;

c0              $soundSpeed;

// Physical properties for radiation pressure
rhol            998.3;
rhog            1.2;
cg              343;
cl              1480;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};


// Piston radiation setup
pistonRadius    0.005;  // [m]
domainRadius    0.2;   // [m] PML starts here
pmlThickness    0.08;   // [m]


// Mesh control (used in .geo template)
cellsPerLambda  50;

// Acoustic frequency
f               6000;
wl              #eval{$c0/$f};
cellSize        #eval{$wl/$cellsPerLambda};

// PML settings (spherical via radial distance)
PMLType         cylindrical;
L               $pmlThickness;
sigmaMax        10000;    // [1/s] PML peak damping
p               3;       // polynomial order
origin          (0 0 0);
Rmin            $domainRadius;
Rmax            #eval{$domainRadius + $pmlThickness};

// ************************************************************************* //
