FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid properties (air, 25 C)
transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;
R               1.51e-3;
p0              0.0;

rhol            998.3;                  // fluid density
rhog            1.2;                  // air density
cg              343;                    // air sound speed
cl              1480;                    // water sound speed
kg              #eval{1.0/($rhog*$cg*$cg)}; // air compressibility
kl              #eval{1.0/($rhol*$cl*$cl)}; // water compressibility

f               10000;               // Driven frequency
sigmaMax        100000;             // [1/s] PML peak damping
po              3;                    // polynomial order
shiftedLaplacianBeta 0.2; // preconditioner shift (freITBCFoam)
cellsPerLambda  80;
wl              #eval{$cg/$f};             // wavelength
cellSize        #eval{$wl/$cellsPerLambda};

PMLType         rectangle;
PMLMax          (0.28 0.28 100);
PMLMin          (-100 -100 -100);          // disable damping at axis/baffle
sigmaMaxVector  (-100000 -100000 0); // radial, axial, wedge
L               #eval{0.28 - 0.2}; // PML thickness

// ************************************************************************* //
