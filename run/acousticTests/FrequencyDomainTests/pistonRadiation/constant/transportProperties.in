FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid properties (air, 25 C)
transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;
R               1.51e-3;
p0              0.0;

rhol            __RHOL__;                  // fluid density
rhog            __RHOG__;                  // air density
cg              __CG__;                    // air sound speed
cl              __CL__;                    // water sound speed
kg              #eval{1.0/($rhog*$cg*$cg)}; // air compressibility
kl              #eval{1.0/($rhol*$cl*$cl)}; // water compressibility

f               __DRIVE_F__;               // Driven frequency
sigmaMax        __SIGMA_MAX__;             // [1/s] PML peak damping
po              __PO__;                    // polynomial order
shiftedLaplacianBeta __SHIFTED_LAPLACIAN_BETA__; // preconditioner shift (freITBCFoam)
cellsPerLambda  __MESH_CELLS_PER_LAMBDA__;
wl              #eval{$cg/$f};             // wavelength
cellSize        #eval{$wl/$cellsPerLambda};

PMLType         rectangle;
PMLMax          (__PML_RMAX__ __PML_RMAX__ 100);
PMLMin          (-100 -100 -100);          // disable damping at axis/baffle
sigmaMaxVector  (-__SIGMA_MAX__ -__SIGMA_MAX__ 0); // radial, axial, wedge
L               #eval{__PML_RMAX__ - __PML_RMIN__}; // PML thickness

// ************************************************************************* //
