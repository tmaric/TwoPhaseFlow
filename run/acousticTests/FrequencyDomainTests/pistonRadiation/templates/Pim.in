FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Pim;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

f   __DRIVE_F__; // driven frequency
u   __PISTON_U__; // driven velocity amplitude
rho __RHOG__;    // air density

boundaryField
{
    piston
    {
        type            fixedGradient;
        gradient        uniform #eval{-2*pi()*$f*$rho*$u};
    }

    bottom
    {
        type            zeroGradient;
    }

    openAir
    {
        type            zeroGradient;
    }

    "(front|back)"
    {
        type            wedge;
    }
}

// ************************************************************************* //
