SumFrefl
{
	libs            ("libutilityFunctionObjects.so");
	type            coded;
	name            SumFrefl;
	writeControl    timeStep;
	writeInterval   1;

	codeWrite
	#{

	    const volScalarField& pr =
	        mesh().lookupObject<volScalarField>("pr");
	     const volTensorField& momFlux =
	         mesh().lookupObject<volTensorField>("momFlux");
	    label   patchID = mesh().boundaryMesh().findPatchID("reflector1");
	        const auto& Sfrefl = mesh().Sf().boundaryField()[patchID];
	    vectorField Frefl = pr.boundaryField()[patchID]*Sfrefl + (momFlux.boundaryField()[patchID]&Sfrefl);
	    vector   sumFrefl = 180*gSum(Frefl);
	    setResult("sumFrefl", sumFrefl);
	    setResult("time", mesh().time().value());
	    // Info<< "##Sum of kinetic_energy = " << SumKinE << endl;

	    if (Pstream::master())
	    {
	     	fileName outputFile = ("./SumFrefl.dat");
	        autoPtr<OFstream> outputFilePtr;

	       // Info << "##breakpoint0"<<endl;
	        if (!exists(outputFile))
	        {
	         //   Info << "##breakpoint1"<<endl;
	            OFstream is(outputFile);
	            outputFilePtr.reset(new OFstream(outputFile));
	           // Info <<"##breakpoint2"<<endl;
	            outputFilePtr() << "time" << tab << "force_x" << tab << "force_y"<< tab << "force_z"<< endl;
	            //outputFilePtr() << "0" << tab << SumAirV <<endl;
	        }

	         outputFilePtr.reset(new OFstream(outputFile,IOstreamOption(),IOstreamOption::APPEND));
	         outputFilePtr() << mesh().time().timeName() << tab << sumFrefl.x()<< tab << sumFrefl.y()<< tab << sumFrefl.z() << endl;
	     }
	#};
}
