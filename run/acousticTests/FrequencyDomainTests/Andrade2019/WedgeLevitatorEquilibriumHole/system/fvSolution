FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        // The fixed interface is reconstructed once to compute sharp alphaf.
        reconstructionScheme plicRDF;
        isoFaceTol           1e-8;
        surfCellTol          1e-8;
    }

    cellDisplacement
    {
        solver          GAMG;
        tolerance       1e-8;
        relTol          0;
        smoother        GaussSeidel;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
}

