#!/bin/sh
set -eu

cd "${0%/*}" || exit 1

STUDY_ROOT="${STUDY_ROOT:-solidBallGorkovStudy}"
RADII_UM="${RADII_UM:-20 30 40 50 60 70 80 90 100 110 120 130 140 150 160 170 180}"
SOLID_RHO="${SOLID_RHO:-2500}"
SOLID_C="${SOLID_C:-5000}"
NPROCS="${NPROCS:-4}"
DROP_SEGMENTS="${DROP_SEGMENTS:-96}"
DROP_CELL_SIZE_FACTOR="${DROP_CELL_SIZE_FACTOR:-0.125}"
MIN_DROP_CELL_SIZE="${MIN_DROP_CELL_SIZE:-2e-6}"

copy_case()
{
    target="$1"

    rm -rf "$target"
    mkdir -p "$target"

    rsync -a \
        --exclude "$STUDY_ROOT" \
        --exclude '0' \
        --exclude '1' \
        --exclude 'constant/polyMesh' \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        ./ "$target"/
}

radius_to_m()
{
    awk -v rum="$1" 'BEGIN{printf "%.12g", rum*1e-6}'
}

radius_cell_size()
{
    awk -v rum="$1" -v fac="$DROP_CELL_SIZE_FACTOR" -v csmin="$MIN_DROP_CELL_SIZE" '
    BEGIN{
        r = rum*1e-6;
        cs = fac*r;
        if (cs < csmin)
        {
            cs = csmin;
        }
        printf "%.12g", cs;
    }'
}

write_case_overrides()
{
    caseDir="$1"
    radiusM="$2"
    cellSize="$3"

    cat > "$caseDir/caseOverrides.sh" <<EOF
# Generated by runSolidBallGorkovStudy.
RHOL=$SOLID_RHO
CL=$SOLID_C
DROP_RADIUS=$radiusM
CFMESH_DROP_CELL_SIZE=$cellSize
CFMESH_DROP_SEGMENTS=$DROP_SEGMENTS
EOF
}

run_case()
{
    caseDir="$1"
    radiusUm="$2"

    radiusM="$(radius_to_m "$radiusUm")"
    cellSize="$(radius_cell_size "$radiusUm")"
    write_case_overrides "$caseDir" "$radiusM" "$cellSize"

    (
        cd "$caseDir" || exit 1
        env \
            RHOL="$SOLID_RHO" \
            CL="$SOLID_C" \
            DROP_RADIUS="$radiusM" \
            CFMESH_DROP_CELL_SIZE="$cellSize" \
            CFMESH_DROP_SEGMENTS="$DROP_SEGMENTS" \
            NPROCS="$NPROCS" \
            ./Allrun
    )
}

extract_force_summary()
{
    awk 'END{print $5 "\t" $7 "\t" $9 "\t" $11}' \
        "$1/postProcessing/dropRadiationForce/force.dat"
}

mkdir -p "$STUDY_ROOT"

summaryFile="$STUDY_ROOT/summary.tsv"
printf "radius_um\tdrop_radius_m\tsim_Fy_axisym\tinterfaceArea_axisym\twetVolume_axisym\tnInterfaceCells\n" > "$summaryFile"

for radiusUm in $RADII_UM
do
    ballDir="$STUDY_ROOT/r${radiusUm}um_hole"

    copy_case "$ballDir"
    run_case "$ballDir" "$radiusUm"

    radiusM="$(radius_to_m "$radiusUm")"
    forceSummary="$(extract_force_summary "$ballDir")"
    printf "%s\t%s\t%s\n" "$radiusUm" "$radiusM" "$forceSummary" >> "$summaryFile"
done

cat "$summaryFile"

python3 ./plotAcousticForceVsRadius.py "$summaryFile" \
    "$STUDY_ROOT/acousticForceVsRadius.png"
