FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticHelmholtzFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    runTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

libs
(
   "libpetscFoam.so"
);

functions
{
    dropRadiationForce
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            dropRadiationForce;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;

        codeInclude
        #{
            #include "fvcGrad.H"
            #include "volFields.H"
        #};

        codeWrite
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volScalarField& pr =
                mesh.lookupObject<volScalarField>("pr");

            const label patchID = mesh.boundaryMesh().findPatchID("dropWall");
            if (patchID < 0)
            {
                FatalErrorInFunction
                    << "Patch 'dropWall' not found."
                    << exit(FatalError);
            }

            vector forceSlice = Zero;
            scalar interfaceAreaSlice = 0.0;
            const auto& Sf = mesh.Sf().boundaryField()[patchID];
            const auto& magSf = mesh.magSf().boundaryField()[patchID];
            const auto& pB = pr.boundaryField()[patchID];

            forAll(pB, facei)
            {
                forceSlice += pB[facei]*Sf[facei];
                interfaceAreaSlice += magSf[facei];
            }
            label interfaceCells = pB.size();

            reduce(forceSlice, sumOp<vector>());
            reduce(interfaceAreaSlice, sumOp<scalar>());
            reduce(interfaceCells, sumOp<label>());

            const scalar axisymScale = 360.0/(__WEDGE_DEG__ + VSMALL);
            const vector forceAxisym = axisymScale*forceSlice;
            const scalar interfaceAreaAxisym = axisymScale*interfaceAreaSlice;
            const scalar wetVolumeAxisym =
                4.0*constant::mathematical::pi*pow3(__DROP_RADIUS__)/3.0;
            const scalar wetVolumeSlice = wetVolumeAxisym/axisymScale;

            if (Pstream::master())
            {
                const fileName outDir
                (
                    mesh.time().globalPath()/"postProcessing"/"dropRadiationForce"
                );
                mkDir(outDir);
                const fileName outFile(outDir/"force.dat");
                const bool writeHeader = !exists(outFile);

                OFstream os(outFile, IOstreamOption(), IOstreamOption::APPEND);
                if (writeHeader)
                {
                    os  << "# time"
                        << tab << "FxSlice"
                        << tab << "FySlice"
                        << tab << "FzSlice"
                        << tab << "FyAxisym"
                        << tab << "interfaceAreaSlice"
                        << tab << "interfaceAreaAxisym"
                        << tab << "wetVolumeSlice"
                        << tab << "wetVolumeAxisym"
                        << tab << "scaleFactor"
                        << tab << "nInterfaceCells" << nl;
                }

                os  << mesh.time().timeName()
                    << tab << forceSlice.x()
                    << tab << forceSlice.y()
                    << tab << forceSlice.z()
                    << tab << forceAxisym.y()
                    << tab << interfaceAreaSlice
                    << tab << interfaceAreaAxisym
                    << tab << wetVolumeSlice
                    << tab << wetVolumeAxisym
                    << tab << axisymScale
                    << tab << interfaceCells << nl;
            }
        #};
    }
}
