#!/bin/sh
set -e
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
. ./caseParams.sh                                   # Case parameters
#------------------------------------------------------------------------------

if [ "${RUN_MODE}" = "fullFig4Sweep" ] && [ "${TPF_INTERNAL_SWEEP_RUN:-0}" != "1" ]; then
    exec ./runHeightSweep.sh
fi

need_cmd()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: required command '$1' not found in PATH" >&2
        exit 1
    fi
}

ensure_solver()
{
    solverName="$1"
    solverDir="$2"
    if command -v "${solverName}" >/dev/null 2>&1; then
        return 0
    fi

    echo "Solver '${solverName}' not found, building ${solverDir} ..."
    repoRoot="$(cd ../../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "solver/${solverDir}"
    )

    if ! command -v "${solverName}" >/dev/null 2>&1; then
        echo "Error: solver '${solverName}' is still unavailable after build." >&2
        exit 1
    fi
}

need_cmd gmsh
need_cmd setExprFields
if [ -z "${NPROCS:-}" ]; then
    NPROCS="${RUN_NPROCS}"
fi
: "${NPROCS:=8}"

rm -f \
    log.gmshToFoam \
    log.changeDictionary \
    log.setExprFields \
    log.decomposePar \
    log.reconstructPar \
    "log.${SOLVER}"

./prepareCase
restore0Dir

gmsh -0 constant/levitatorWedgeHex.geo
runApplication gmshToFoam  constant/levitatorWedgeHex.msh
rm constant/levitatorWedgeHex.msh
runApplication changeDictionary

case "${DROP_MODE}" in
    empty)
        ;;
    oblate)
        runApplication setExprFields -time 0
        ;;
    *)
        echo "Unsupported DROP_MODE='${DROP_MODE}'. Use 'empty' or 'oblate'." >&2
        exit 1
        ;;
esac

rm -f 0/Pim.in

ensure_solver "${SOLVER}" acousticHelmholtzFoam
rm -f "log.${SOLVER}"
rm -rf processor*
runApplication decomposePar -force
runParallel "${SOLVER}"
runApplication reconstructPar -latestTime

#------------------------------------------------------------------------------
