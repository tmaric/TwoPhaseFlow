FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// All properties are in T=25 C and P=100 kPa
transportModel  Newtonian;
soundSpeed      343;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;

R               1.51e-3;
p0              0.0;

c0              $soundSpeed;
// frequency
f               25250;
// physical properties
rhol            998.3;
rhog            1.2;
cg              343;
cl              1480;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};
k               #eval{2.0*pi()*$f/$soundSpeed};
L               0.008;

PMLType         rectangle;
PMLMax          (0.029 0.0235841584158 100);
PMLMin          (-100 -0.01 -100);
sigmaMax        3000;
po              3;
// ************************************************************************* //
