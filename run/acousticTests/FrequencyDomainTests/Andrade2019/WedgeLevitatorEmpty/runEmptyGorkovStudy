#!/bin/sh
set -eu

cd "${0%/*}" || exit 1

STUDY_ROOT="${STUDY_ROOT:-emptyGorkovStudy}"
RADII_UM="${RADII_UM:-20 30 40 50 60 70 80 90 100 110 120 130 140 150}"

SOLID_RHO="${SOLID_RHO:-2500}"
SOLID_C="${SOLID_C:-5000}"
PARTICLE_CENTER_Y="${PARTICLE_CENTER_Y:-0.0040003}"
HOLE_SUMMARY="${HOLE_SUMMARY:-../WedgeLevitatorGorkovHole/solidBallGorkovStudy/summary.tsv}"

if [ ! -f 1/Pre ] || [ ! -f 1/Ure ] || [ ! -f 1/Uim ]; then
    ./Allrun
fi

radius_to_m()
{
    awk -v rum="$1" 'BEGIN{printf "%.12g", rum*1e-6}'
}

copy_case()
{
    target="$1"

    rm -rf "$target"
    mkdir -p "$target"

    rsync -a \
        --exclude "$STUDY_ROOT" \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        ./ "$target"/
}

write_case_overrides()
{
    caseDir="$1"
    radiusM="$2"

    cat > "$caseDir/caseOverrides.sh" <<EOF
# Generated by runEmptyGorkovStudy.
RHOL=$SOLID_RHO
CL=$SOLID_C
PARTICLE_RADIUS=$radiusM
PARTICLE_CENTER_Y=$PARTICLE_CENTER_Y
EOF
}

run_case()
{
    caseDir="$1"
    radiusUm="$2"

    radiusM="$(radius_to_m "$radiusUm")"
    write_case_overrides "$caseDir" "$radiusM"

    (
        cd "$caseDir" || exit 1
        ./prepareCase
        rm -rf postProcessing/gorkovPointForce
        postProcess -dict system/controlDict -fields '(Pre Pim Ure Uim)' -latestTime \
            > log.postProcess.gorkovPointForce 2>&1
    )
}

extract_empty_force()
{
    awk 'END{print $2 "\t" $10 "\t" $12}' \
        "$1/postProcessing/gorkovPointForce/force.dat"
}

mkdir -p "$STUDY_ROOT"

summaryFile="$STUDY_ROOT/summary.tsv"
printf "radius_um\tparticle_radius_m\tempty_Fy_gorkov\tsampleDistance\n" > "$summaryFile"

for radiusUm in $RADII_UM
do
    caseDir="$STUDY_ROOT/r${radiusUm}um_empty"

    copy_case "$caseDir"
    run_case "$caseDir" "$radiusUm"

    forceSummary="$(extract_empty_force "$caseDir")"
    printf "%s\t%s\n" "$radiusUm" "$forceSummary" >> "$summaryFile"
done

cat "$summaryFile"

python3 ./plotGorkovForceComparison.py "$summaryFile" "$HOLE_SUMMARY" \
    "$STUDY_ROOT/gorkovVsHoleForce.png" \
    "$STUDY_ROOT/gorkovVsHoleForce.tsv"
