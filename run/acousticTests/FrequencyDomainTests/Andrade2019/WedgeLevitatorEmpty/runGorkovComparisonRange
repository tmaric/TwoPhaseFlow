#!/bin/sh
set -eu

cd "${0%/*}" || exit 1

usage()
{
    cat <<'EOF'
Usage:
  ./runGorkovComparisonRange START_UM END_UM STEP_UM

Example:
  ./runGorkovComparisonRange 20 80 5

Environment overrides are passed through to the underlying studies, for example:
  NPROCS=16 DROP_SEGMENTS=96 ./runGorkovComparisonRange 20 80 5

Optional output roots:
  HOLE_STUDY_ROOT   default: solidBallGorkovStudy
  EMPTY_STUDY_ROOT  default: emptyGorkovStudy
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 3 ]; then
    usage >&2
    exit 2
fi

START_UM="$1"
END_UM="$2"
STEP_UM="$3"

RADII_UM="$(
    awk -v start="$START_UM" -v stop="$END_UM" -v step="$STEP_UM" '
    BEGIN {
        if (step <= 0) {
            print "Error: STEP_UM must be positive" > "/dev/stderr";
            exit 1;
        }
        if (stop < start) {
            print "Error: END_UM must be greater than or equal to START_UM" > "/dev/stderr";
            exit 1;
        }

        eps = step*1e-9;
        for (r = start; r <= stop + eps; r += step) {
            value = sprintf("%.12g", r);
            radii = radii sep value;
            sep = " ";
        }
        print radii;
    }'
)"

HOLE_CASE_DIR="${HOLE_CASE_DIR:-../WedgeLevitatorGorkovHole}"
HOLE_STUDY_ROOT="${HOLE_STUDY_ROOT:-solidBallGorkovStudy}"
EMPTY_STUDY_ROOT="${EMPTY_STUDY_ROOT:-emptyGorkovStudy}"

echo "Running Gorkov comparison radius sweep:"
echo "  RADII_UM=$RADII_UM"
echo "  HOLE_CASE_DIR=$HOLE_CASE_DIR"
echo "  HOLE_STUDY_ROOT=$HOLE_STUDY_ROOT"
echo "  EMPTY_STUDY_ROOT=$EMPTY_STUDY_ROOT"

(
    cd "$HOLE_CASE_DIR" || exit 1
    STUDY_ROOT="$HOLE_STUDY_ROOT" \
    RADII_UM="$RADII_UM" \
    ./runSolidBallGorkovStudy
)

HOLE_SUMMARY="$(
    cd "$HOLE_CASE_DIR" || exit 1
    printf "%s/%s/summary.tsv" "$(pwd)" "$HOLE_STUDY_ROOT"
)"

STUDY_ROOT="$EMPTY_STUDY_ROOT" \
RADII_UM="$RADII_UM" \
HOLE_SUMMARY="$HOLE_SUMMARY" \
./runEmptyGorkovStudy

echo "Comparison complete:"
echo "  $EMPTY_STUDY_ROOT/gorkovVsHoleForce.tsv"
echo "  $EMPTY_STUDY_ROOT/gorkovVsHoleForce.png"
