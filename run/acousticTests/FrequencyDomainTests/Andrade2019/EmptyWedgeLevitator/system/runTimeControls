runTimeControl1
{
    type            runTimeControl;
    libs            (utilityFunctionObjects);
    conditions
    {
        condition1
        {
            type            minMax;
            functionObject  SumFrefl;
            fields          (time);
            value           300; // start evaluating results after 12 periods
            mode            maximum;
        }
    }
    satisfiedAction setTrigger;
    trigger         1;
}

runTimeControl2
{
    type            runTimeControl;
    libs            (utilityFunctionObjects);
    controlMode     trigger;
    triggerStart    1;

    conditions
    {
        condition2
        {
            type            average;
            functionObject  SumFrefl;
            fields          (sumFrefl);
            tolerance       1e-8; // abs(currentVal - averageVal) < tol
            window          50; //#eval{10/40000}; //average in a window of length 10 periods
            windowType      exact;
        }
    }
    satisfiedAction end;
}
