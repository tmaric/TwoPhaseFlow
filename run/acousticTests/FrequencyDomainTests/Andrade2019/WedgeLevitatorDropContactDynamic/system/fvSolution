FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         0;
        clip            false;
        cAlpha          1;
        nAlphaSubCycles 1;
        advectionScheme isoAdvection;
        reconstructionScheme plicRDF;
    }

    pcorr
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-9;//1e-12;
        relTol          0;
    }

    pcorrFinal
    {
        $pcorr;
    }

    p_rgh
    {
        //solver          PCG;
        //preconditioner  DIC;
        solver          GAMG; //PCG;
        smoother    DICGaussSeidel;
        tolerance       1e-9; //1e-12;
        relTol          0.0;
        minIter         10;
    }

    p_rghFinal
    {
        $p_rgh;
    }

}

// lentSC
PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    2;
    nCorrectors         3;
    nNonOrthogonalCorrectors 1;
    pRefCell            0;
    pRefValue           0;

    // TODO (TT): re-enable once LENT is ported into Argo

    residualControl
    {
        p_rgh
        {
                tolerance  1e-12;
                relTol     0;
        }
     }

}

