#!/bin/sh
set -eu

cd "${0%/*}" || exit 1

usage()
{
    cat <<'EOF'
Usage:
  ./runGorkovComparison
  ./runGorkovComparison START_UM END_UM STEP_UM

The script runs the full Gorkov comparison from this DropHole case folder:
  1. solve the empty levitator acoustic field with the gmsh workflow;
  2. postprocess the empty field for the requested particle radii;
  3. solve the hard-ball DropHole cases with the cfMesh workflow;
  4. compare both force summaries with plotGorkovForceComparison.py.

Environment overrides:
  RADII_UM            explicit radius list, default: 20 ... 150
  EMPTY_TEMPLATE      default: emptyGmshTemplate
  EMPTY_FIELD_CASE    default: emptyLevitatorField
  EMPTY_STUDY_ROOT    default: emptyGorkovStudy
  HOLE_STUDY_ROOT     default: solidBallGorkovStudy
  COMPARISON_ROOT     default: gorkovComparison
  NPROCS              passed to both acoustic solves
  SOLID_RHO, SOLID_C  particle/solid properties
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -eq 3 ]; then
    RADII_UM="$(
        awk -v start="$1" -v stop="$2" -v step="$3" '
        BEGIN {
            if (step <= 0) {
                print "Error: STEP_UM must be positive" > "/dev/stderr";
                exit 1;
            }
            if (stop < start) {
                print "Error: END_UM must be greater than or equal to START_UM" > "/dev/stderr";
                exit 1;
            }

            eps = step*1e-9;
            for (r = start; r <= stop + eps; r += step) {
                value = sprintf("%.12g", r);
                radii = radii sep value;
                sep = " ";
            }
            print radii;
        }'
    )"
elif [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
fi

RADII_UM="${RADII_UM:-20 30 40 50 60 70 80 90 100 110 120 130 140 150}"
EMPTY_TEMPLATE="${EMPTY_TEMPLATE:-emptyGmshTemplate}"
EMPTY_FIELD_CASE="${EMPTY_FIELD_CASE:-emptyLevitatorField}"
EMPTY_STUDY_ROOT="${EMPTY_STUDY_ROOT:-emptyGorkovStudy}"
HOLE_STUDY_ROOT="${HOLE_STUDY_ROOT:-solidBallGorkovStudy}"
COMPARISON_ROOT="${COMPARISON_ROOT:-gorkovComparison}"

SOLID_RHO="${SOLID_RHO:-2500}"
SOLID_C="${SOLID_C:-5000}"
PARTICLE_CENTER_Y="${PARTICLE_CENTER_Y:-0.0040003}"

radius_to_m()
{
    awk -v rum="$1" 'BEGIN{printf "%.12g", rum*1e-6}'
}

copy_empty_template()
{
    target="$1"

    rm -rf "$target"
    mkdir -p "$target"
    rsync -a \
        --exclude 'caseOverrides.sh' \
        --exclude '0' \
        --exclude '1' \
        --exclude 'constant/polyMesh' \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        "$EMPTY_TEMPLATE"/ "$target"/
}

copy_solved_empty_case()
{
    target="$1"

    rm -rf "$target"
    mkdir -p "$target"
    rsync -a \
        --exclude "$EMPTY_STUDY_ROOT" \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.postProcess.*' \
        "$EMPTY_FIELD_CASE"/ "$target"/
}

write_empty_overrides()
{
    caseDir="$1"
    radiusM="$2"

    cat > "$caseDir/caseOverrides.sh" <<EOF
# Generated by runGorkovComparison.
RHOL=$SOLID_RHO
CL=$SOLID_C
PARTICLE_RADIUS=$radiusM
PARTICLE_CENTER_Y=$PARTICLE_CENTER_Y
EOF
}

run_empty_field_case()
{
    echo "Running empty levitator acoustic field with gmsh in $EMPTY_FIELD_CASE"
    copy_empty_template "$EMPTY_FIELD_CASE"
    (
        cd "$EMPTY_FIELD_CASE" || exit 1
        NPROCS="${NPROCS:-}" ./Allrun
    )
}

run_empty_gorkov_case()
{
    caseDir="$1"
    radiusUm="$2"
    radiusM="$(radius_to_m "$radiusUm")"

    copy_solved_empty_case "$caseDir"
    write_empty_overrides "$caseDir" "$radiusM"

    (
        cd "$caseDir" || exit 1
        ./prepareCase
        rm -rf postProcessing/gorkovPointForce
        postProcess -dict system/controlDict -fields '(Pre Pim Ure Uim)' -latestTime \
            > log.postProcess.gorkovPointForce 2>&1
    )
}

extract_empty_force()
{
    awk 'END{print $2 "\t" $10 "\t" $12}' \
        "$1/postProcessing/gorkovPointForce/force.dat"
}

write_empty_summary()
{
    mkdir -p "$EMPTY_STUDY_ROOT"

    summaryFile="$EMPTY_STUDY_ROOT/summary.tsv"
    printf "radius_um\tparticle_radius_m\tempty_Fy_gorkov\tsampleDistance\n" > "$summaryFile"

    for radiusUm in $RADII_UM
    do
        caseDir="$EMPTY_STUDY_ROOT/r${radiusUm}um_empty"
        echo "Postprocessing empty-field Gorkov force for radius ${radiusUm} um"
        run_empty_gorkov_case "$caseDir" "$radiusUm"
        forceSummary="$(extract_empty_force "$caseDir")"
        printf "%s\t%s\n" "$radiusUm" "$forceSummary" >> "$summaryFile"
    done

    cat "$summaryFile"
}

echo "Running Gorkov comparison radius sweep:"
echo "  RADII_UM=$RADII_UM"
echo "  EMPTY_FIELD_CASE=$EMPTY_FIELD_CASE"
echo "  EMPTY_STUDY_ROOT=$EMPTY_STUDY_ROOT"
echo "  HOLE_STUDY_ROOT=$HOLE_STUDY_ROOT"
echo "  COMPARISON_ROOT=$COMPARISON_ROOT"

run_empty_field_case
write_empty_summary

echo "Running DropHole hard-ball acoustic cases with cfMesh"
STUDY_ROOT="$HOLE_STUDY_ROOT" \
RADII_UM="$RADII_UM" \
SOLID_RHO="$SOLID_RHO" \
SOLID_C="$SOLID_C" \
EMPTY_TEMPLATE="$EMPTY_TEMPLATE" \
EMPTY_FIELD_CASE="$EMPTY_FIELD_CASE" \
EMPTY_STUDY_ROOT="$EMPTY_STUDY_ROOT" \
COMPARISON_ROOT="$COMPARISON_ROOT" \
./runSolidBallGorkovStudy

mkdir -p "$COMPARISON_ROOT"
python3 ./plotGorkovForceComparison.py \
    "$EMPTY_STUDY_ROOT/summary.tsv" \
    "$HOLE_STUDY_ROOT/summary.tsv" \
    "$COMPARISON_ROOT/gorkovVsHoleForce.png" \
    "$COMPARISON_ROOT/gorkovVsHoleForce.tsv"

echo "Comparison complete:"
echo "  $EMPTY_STUDY_ROOT/summary.tsv"
echo "  $HOLE_STUDY_ROOT/summary.tsv"
echo "  $COMPARISON_ROOT/gorkovVsHoleForce.tsv"
echo "  $COMPARISON_ROOT/gorkovVsHoleForce.png"
