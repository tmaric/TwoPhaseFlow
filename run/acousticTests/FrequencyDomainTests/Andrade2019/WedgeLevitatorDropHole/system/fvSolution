FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        // This required bei InterIsoRhoFoam, but not by InterIsoFoam, why? (TT)
        nAlphaCorr      2;

        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         0;
        clip            false;
        cAlpha          1;
        nAlphaSubCycles 1;
        advectionScheme isoAdvection;
        reconstructionScheme plicRDF;        
    }

    "P.*"
    {
          solver          PCG;
          preconditioner  DIC;
          tolerance       1e-6;
          relTol          0.0;
          // debug           1;
    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 8;
    pRefCell        0;
    pRefValue       0;
}

relaxationFactors
{
fields
{
    Pre         0.01;//1;//0.1;
    Pim         0.01;//1;//0.1;
}
equations
{
        ".*"            0;
}
}


