FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setAlphaFieldDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

field           alpha.water;
type            ellipsoid;
effectiveRadius __DROP_RADIUS__;
horizontalLongAxis __DROP_HORIZONTAL_LONG_AXIS__;
origin          (__DROP_CENTER_X__ __DROP_CENTER_Y__ __DROP_CENTER_Z__);

// ************************************************************************* //
