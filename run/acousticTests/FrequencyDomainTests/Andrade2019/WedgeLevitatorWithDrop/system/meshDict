FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceFile "constant/levitator.stl";

maxCellSize #eval{0.01/100};

boundaryLayers
{
    nLayers     1;

    patchBoundaryLayers
    {

         "(transducer.*|reflector)"
         {
              nLayers    3;
              thicknessRatio     1.2;
         }
     }

     optimiseLayer 1;

     optimisationParameters
     {
         nSmoothNormals      5;
         relThicknessTol     0.15;
         featureSizeFactor   0.3;
         reCalculateNormals  1;
         maxNumIterations    5;
     }
}


