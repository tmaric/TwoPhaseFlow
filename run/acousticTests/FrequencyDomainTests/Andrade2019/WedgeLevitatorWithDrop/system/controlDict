FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     mySonicLiquidFoam;

startFrom       latestTime;//startTime;

startTime       0;

stopAt          endTime;

endTime         8000;//200e-3; // 2e-7; //50e-6;

deltaT          1;//1e-7; 

writeControl    runTime; //timeStep;

writeInterval   50; //1e-4; //#eval{1.0*10/25250}; //1000; //5; //1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.25;

maxDeltaT       5e-6;

// ************************************************************************* //
functions
{
    #include "FOforce"
    #include "runTimeControls"
}

