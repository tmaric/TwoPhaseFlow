FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Pim;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    transducer
    {
        type            fixedValue;
        value           uniform __TRANSDUCER_PIM__;
    }
    "(reflector|outerWall|dropWall)"
    {
        type            zeroGradient;
    }
    axis
    {
        type            symmetryPlane;
    }
    "(front|back)"
    {
        type            wedge;
    }
}

// ************************************************************************* //
