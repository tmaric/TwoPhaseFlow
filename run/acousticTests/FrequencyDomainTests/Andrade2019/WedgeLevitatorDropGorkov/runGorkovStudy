#!/bin/sh
set -eu

cd "${0%/*}" || exit 1
. ./caseParams.sh

STUDY_ROOT=${STUDY_ROOT:-gorkovStudy}
RADII_UM=${RADII_UM:-"30 40 60 80 100 120 150"}
DROP_CELL_SIZE_FACTOR=${DROP_CELL_SIZE_FACTOR:-0.0625}
MIN_DROP_CELL_SIZE=${MIN_DROP_CELL_SIZE:-1e-6}
DROP_SEGMENTS=${DROP_SEGMENTS:-128}
KEEP_CASES=${KEEP_CASES:-0}

copy_case()
{
    target=$1
    rm -rf "$target"
    mkdir -p "$target"
    rsync -a \
        --exclude "$STUDY_ROOT" \
        --exclude 'meshConvergence' \
        --exclude '0' \
        --exclude '1' \
        --exclude 'constant/polyMesh' \
        --exclude 'constant/levitator2D.fms' \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        ./ "$target/"
}

radius_to_m()
{
    awk -v radius_um="$1" 'BEGIN{printf "%.12g", radius_um*1e-6}'
}

drop_cell_size()
{
    awk -v radius_um="$1" -v factor="$DROP_CELL_SIZE_FACTOR" \
        -v minimum="$MIN_DROP_CELL_SIZE" '
        BEGIN {
            size = radius_um*1e-6*factor;
            if (size < minimum) size = minimum;
            printf "%.12g", size;
        }'
}

mkdir -p "$STUDY_ROOT"
raw="$STUDY_ROOT/raw_results.tsv"
printf "radius_um\tradius_m\tdrop_cell_size_m\tn_cells\tn_surface_faces\tmax_nonorthogonality_deg\tavg_nonorthogonality_deg\tmax_skewness\tnumerical_force_y_N\n" > "$raw"

for radius_um in $RADII_UM
do
    radius_m=$(radius_to_m "$radius_um")
    cell_size=$(drop_cell_size "$radius_um")
    case_dir="$STUDY_ROOT/r${radius_um}um"

    echo "Running radius ${radius_um} um (sphere cell size ${cell_size} m)"
    copy_case "$case_dir"

    printf '%s\n' \
        '# Generated by runGorkovStudy.' \
        "DROP_RADIUS=$radius_m" \
        "CFMESH_DROP_CELL_SIZE=$cell_size" \
        "CFMESH_DROP_SEGMENTS=$DROP_SEGMENTS" \
        > "$case_dir/caseOverrides.sh"

    (cd "$case_dir" && ./Allrun)

    n_cells=$(awk '/cells:/ {print $2; exit}' "$case_dir/log.checkMesh")
    mesh_metrics=$(awk '
        /Mesh non-orthogonality Max:/ {maximum=$4; average=$6}
        /Max skewness/ {skewness=$4}
        END {print maximum "\t" average "\t" skewness}
    ' "$case_dir/log.checkMesh")
    force_file="$case_dir/postProcessing/dropRadiationForce/force.dat"
    force_y=$(awk '!/^#/ {value=$5} END{print value}' "$force_file")
    n_faces=$(awk '!/^#/ {value=$8} END{print value}' "$force_file")

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$radius_um" "$radius_m" "$cell_size" "$n_cells" "$n_faces" \
        "$mesh_metrics" "$force_y" >> "$raw"

    if [ "$KEEP_CASES" -eq 0 ]; then
        rm -rf "$case_dir"
    fi
done

python3 ./postprocessGorkovStudy.py \
    --input "$raw" \
    --output "$STUDY_ROOT/gorkov_comparison.tsv" \
    --figure "$STUDY_ROOT/gorkov_comparison.png" \
    --frequency "$DRIVE_F" \
    --pressure-amplitude "$PRESSURE_AMPLITUDE" \
    --density "$RHOG" \
    --sound-speed "$CG" \
    --particle-y "$DROP_CENTER_Y"

cat "$STUDY_ROOT/gorkov_comparison.tsv"
