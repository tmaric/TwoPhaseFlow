#!/bin/sh
set -eu

cd "${0%/*}" || exit 1
. ./caseParams.sh

STUDY_ROOT=${STUDY_ROOT:-meshConvergence}
TEST_RADIUS_UM=${TEST_RADIUS_UM:-60}
KEEP_CASES=${KEEP_CASES:-0}

copy_case()
{
    target=$1
    mkdir -p "$target"
    rsync -a \
        --exclude "$STUDY_ROOT" \
        --exclude 'gorkovStudy' \
        --exclude 'meshConvergence' \
        --exclude 'positionSweep' \
        --exclude 'smokeStudy' \
        --exclude '0' \
        --exclude '1' \
        --exclude 'constant/polyMesh' \
        --exclude 'constant/levitator2D.fms' \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        ./ "$target/"
}

radius_m=$(awk -v radius_um="$TEST_RADIUS_UM" \
    'BEGIN{printf "%.12g", radius_um*1e-6}')

mkdir -p "$STUDY_ROOT"
raw="$STUDY_ROOT/raw_results.tsv"
printf "level\th_over_a\tsegments\tcell_size_m\tn_cells\tn_surface_faces\tmax_nonorthogonality_deg\tavg_nonorthogonality_deg\tmax_skewness\tnumerical_force_y_N\n" > "$raw"

for specification in "coarse 0.125 64" "medium 0.0625 128" "fine 0.03125 256"
do
    set -- $specification
    level=$1
    h_over_a=$2
    segments=$3
    cell_size=$(awk -v radius="$radius_m" -v ratio="$h_over_a" \
        'BEGIN{printf "%.12g", radius*ratio}')
    case_dir="$STUDY_ROOT/$level"

    echo "Running $level level (h/a=$h_over_a, segments=$segments)"
    if [ -d "$case_dir" ]; then
        find "$case_dir" -depth -delete
    fi
    copy_case "$case_dir"
    printf '%s\n' \
        '# Generated by runMeshConvergence.' \
        "DROP_RADIUS=$radius_m" \
        "CFMESH_DROP_CELL_SIZE=$cell_size" \
        "CFMESH_DROP_SEGMENTS=$segments" \
        > "$case_dir/caseOverrides.sh"

    (cd "$case_dir" && ./Allrun)

    n_cells=$(awk '/cells:/ {print $2; exit}' "$case_dir/log.checkMesh")
    mesh_metrics=$(awk '
        /Mesh non-orthogonality Max:/ {maximum=$4; average=$6}
        /Max skewness/ {skewness=$4}
        END {print maximum "\t" average "\t" skewness}
    ' "$case_dir/log.checkMesh")
    force_file="$case_dir/postProcessing/dropRadiationForce/force.dat"
    force_y=$(awk '!/^#/ {value=$5} END{print value}' "$force_file")
    n_faces=$(awk '!/^#/ {value=$8} END{print value}' "$force_file")

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$level" "$h_over_a" "$segments" "$cell_size" "$n_cells" \
        "$n_faces" "$mesh_metrics" "$force_y" >> "$raw"

    if [ "$KEEP_CASES" -eq 0 ]; then
        find "$case_dir" -depth -delete
    fi
done

python3 ./postprocessMeshConvergence.py \
    --input "$raw" \
    --output "$STUDY_ROOT/mesh_convergence.tsv" \
    --figure "$STUDY_ROOT/mesh_convergence.png" \
    --radius "$radius_m" \
    --frequency "$DRIVE_F" \
    --pressure-amplitude "$PRESSURE_AMPLITUDE" \
    --density "$RHOG" \
    --sound-speed "$CG" \
    --particle-y "$DROP_CENTER_Y"

cat "$STUDY_ROOT/mesh_convergence.tsv"
