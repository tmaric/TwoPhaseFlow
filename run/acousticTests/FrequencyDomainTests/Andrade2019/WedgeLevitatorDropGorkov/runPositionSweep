#!/bin/sh
set -eu

cd "${0%/*}" || exit 1
. ./caseParams.sh

STUDY_ROOT=${STUDY_ROOT:-positionSweep}
TEST_RADIUS_UM=${TEST_RADIUS_UM:-60}
KEEP_CASES=${KEEP_CASES:-0}
DROP_CELL_SIZE_FACTOR=${DROP_CELL_SIZE_FACTOR:-0.0625}
DROP_SEGMENTS=${DROP_SEGMENTS:-128}

quarter_wave_mm=$(awk -v c="$CG" -v f="$DRIVE_F" \
    'BEGIN{printf "%.10g", 1000*c/(4*f)}')
half_wave_mm=$(awk -v q="$quarter_wave_mm" \
    'BEGIN{printf "%.10g", 2*q}')
POSITIONS_MM=${POSITIONS_MM:-"0.6 1.4 2.2 3.0 $quarter_wave_mm 4.0 4.8 5.6 6.4 $half_wave_mm 7.1"}

copy_case()
{
    target=$1
    mkdir -p "$target"
    rsync -a \
        --exclude "$STUDY_ROOT" \
        --exclude 'gorkovStudy' \
        --exclude 'meshConvergence' \
        --exclude 'positionSweep' \
        --exclude 'smokeStudy' \
        --exclude '0' \
        --exclude '1' \
        --exclude 'constant/polyMesh' \
        --exclude 'constant/levitator2D.fms' \
        --exclude 'processor*' \
        --exclude 'postProcessing' \
        --exclude 'dynamicCode' \
        --exclude 'log.*' \
        ./ "$target/"
}

radius_m=$(awk -v radius_um="$TEST_RADIUS_UM" \
    'BEGIN{printf "%.12g", radius_um*1e-6}')
cell_size=$(awk -v radius="$radius_m" -v factor="$DROP_CELL_SIZE_FACTOR" \
    'BEGIN{printf "%.12g", radius*factor}')

mkdir -p "$STUDY_ROOT"
raw="$STUDY_ROOT/raw_results.tsv"
printf "position_mm\tposition_m\tn_cells\tn_surface_faces\tmax_nonorthogonality_deg\tavg_nonorthogonality_deg\tmax_skewness\tnumerical_force_y_N\n" > "$raw"

case_index=0
for position_mm in $POSITIONS_MM
do
    case_index=$((case_index + 1))
    position_m=$(awk -v position_mm="$position_mm" \
        'BEGIN{printf "%.12g", position_mm*1e-3}')
    case_dir=$(printf "%s/p%02d_%smm" "$STUDY_ROOT" "$case_index" "$position_mm")

    echo "Running particle position y=${position_mm} mm"
    if [ -d "$case_dir" ]; then
        find "$case_dir" -depth -delete
    fi
    copy_case "$case_dir"
    printf '%s\n' \
        '# Generated by runPositionSweep.' \
        "DROP_RADIUS=$radius_m" \
        "DROP_CENTER_Y=$position_m" \
        "CFMESH_DROP_CELL_SIZE=$cell_size" \
        "CFMESH_DROP_SEGMENTS=$DROP_SEGMENTS" \
        > "$case_dir/caseOverrides.sh"

    (cd "$case_dir" && ./Allrun)

    n_cells=$(awk '/cells:/ {print $2; exit}' "$case_dir/log.checkMesh")
    mesh_metrics=$(awk '
        /Mesh non-orthogonality Max:/ {maximum=$4; average=$6}
        /Max skewness/ {skewness=$4}
        END {print maximum "\t" average "\t" skewness}
    ' "$case_dir/log.checkMesh")
    force_file="$case_dir/postProcessing/dropRadiationForce/force.dat"
    force_y=$(awk '!/^#/ {value=$5} END{print value}' "$force_file")
    n_faces=$(awk '!/^#/ {value=$8} END{print value}' "$force_file")

    printf "%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$position_mm" "$position_m" "$n_cells" "$n_faces" \
        "$mesh_metrics" "$force_y" >> "$raw"

    if [ "$KEEP_CASES" -eq 0 ]; then
        find "$case_dir" -depth -delete
    fi
done

python3 ./postprocessPositionSweep.py \
    --input "$raw" \
    --output "$STUDY_ROOT/position_sweep.tsv" \
    --figure "$STUDY_ROOT/position_sweep.png" \
    --radius "$radius_m" \
    --frequency "$DRIVE_F" \
    --pressure-amplitude "$PRESSURE_AMPLITUDE" \
    --density "$RHOG" \
    --sound-speed "$CG" \
    --height "$H"

cat "$STUDY_ROOT/position_sweep.tsv"
