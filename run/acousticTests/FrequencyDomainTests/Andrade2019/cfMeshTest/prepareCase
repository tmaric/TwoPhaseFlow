($RRBU $DPHS 0)
($RR $DPHS 0)
($RT $DPHS 0)
($RT $D 0)
($AXIS_RADIUS $D 0)

($AXIS_RADIUS 0 $SURFACE_THICKNESS)
($RT 0 $SURFACE_THICKNESS)
($RR 0 $SURFACE_THICKNESS)
($RR -$HS $SURFACE_THICKNESS)
($RRBU -$HS $SURFACE_THICKNESS)
($RRBU 0 $SURFACE_THICKNESS)
($RRBU $D $SURFACE_THICKNESS)
($RRBU $DPHS $SURFACE_THICKNESS)
($RR $DPHS $SURFACE_THICKNESS)
($RT $DPHS $SURFACE_THICKNESS)
($RT $D $SURFACE_THICKNESS)
($AXIS_RADIUS $D $SURFACE_THICKNESS)
)

