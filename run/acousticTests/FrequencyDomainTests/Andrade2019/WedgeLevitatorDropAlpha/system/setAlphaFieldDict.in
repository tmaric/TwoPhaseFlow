FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setAlphaFieldDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

field           alpha.water;
type            sphere;
direction       (0 0 1);
radius          __DROP_RADIUS__;
origin          (0.00000001 __DROP_CENTER_Y__ 0.0000001);

// ************************************************************************* //
