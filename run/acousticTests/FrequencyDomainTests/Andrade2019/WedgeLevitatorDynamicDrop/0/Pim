FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
   openAir
    {
        type            zeroGradient;
    }
    transducer1
    {
         type            fixedGradient;
         gradient        uniform #eval{-2*pi()*25250*1.2*0.05};
    }
    "(transducer2|reflector2|reflector1)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}

