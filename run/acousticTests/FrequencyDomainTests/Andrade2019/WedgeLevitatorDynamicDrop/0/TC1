FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      TC1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    front
    {
        type            wedge;
    }
    reflector1
    {
        type            calculated;
        value           uniform 0;
    }
    transducer1
    {
        type            calculated;
        value           uniform 0;
    }
    back
    {
        type            wedge;
    }
    reflector2
    {
        type            calculated;
        value           uniform 0;
    }
    openAir
    {
        type            calculated;
        value           uniform 0;
    }
    transducer2
    {
        type            calculated;
        value           uniform 0;
    }
}


