FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   dynamicRefineFvMesh;

// Refine every time step once the run has advanced past time index 0.
refineInterval  1;

// Standard VOF interface-band refinement.
field           alpha.water;
lowerRefineLevel 0.001;
upperRefineLevel 0.999;
unrefineLevel   10;

// Keep the first trial conservative to limit topology churn.
nBufferLayers   2;
maxRefinement   1;
maxCells        1200000;

// Most of these custom surface fields are regenerated every step; use
// 'none' initially to avoid AMR remap warnings during the first trial.
correctFluxes
(
    (phi none)
    (phiPrevIter none)
    (rhoPhi none)
    (alphaPhi none)
    (alphaPhi_ none)
    (talphaPhiCorr0_ none)
    (alphaf none)
    (beta none)
    (ghf none)
    (phi0 none)
    (dVf_ none)
    (Kf_ none)
    (nHatf none)
    (nHatf_ none)
    (deltaFunction_ none)
);

dumpLevel       true;

