FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water air);

// Two-phase flow properties for interFALFlow
nu_droplet  0.0;
nu_ambient  0.0;
rho_droplet __RHOL__;
rho_ambient __RHOG__;

water
{
    transportModel  Newtonian;
    nu              nu [ 0 2 -1 0 0 0 0 ] $nu_droplet;
    rho             rho [ 1 -3 0 0 0 0 0 ] $rho_droplet;
}

air
{
    transportModel  Newtonian;
    nu              nu [ 0 2 -1 0 0 0 0 ] $nu_ambient;
    rho             rho [ 1 -3 0 0 0 0 0 ] $rho_ambient;
}

sigma           sigma [ 1 0 -2 0 0 0 0 ] 0.072;

surfaceForces
{
  sigma 0.072;
  surfaceTensionForceModel RDF;
  accelerationForceModel gravity;
  deltaFunctionModel alphaCSF;
}

// Acoustic properties used by the coupling model
soundSpeed      __SOUND_SPEED__;
f               __DRIVE_F__;
rhol            __RHOL__;
rhog            __RHOG__;
cg              __CG__;
cl              __CL__;
acousticForceModel __ACOUSTIC_FORCE_MODEL__;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};
k               #eval{2.0*pi()*$f/$soundSpeed};
L               __PML_L__;

PMLType         rectangle;
PMLMax          (__PML_MAX_X__ __PML_MAX_Y__ __PML_MAX_Z__);
PMLMin          (__PML_MIN_X__ __PML_MIN_Y__ __PML_MIN_Z__);
sigmaMax        __SIGMA_MAX__;
po              __PO__;
// ************************************************************************* //
