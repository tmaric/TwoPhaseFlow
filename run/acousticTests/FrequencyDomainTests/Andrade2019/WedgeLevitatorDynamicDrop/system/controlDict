// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     interFALFlow;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-1;

deltaT          2e-05;

writeControl    runTime;

writeInterval   2e-4;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  off;

maxCo           0.2;

maxAlphaCo      0.2;

maxDeltaT       1e-06;

maxCapillaryNum 10000000;


