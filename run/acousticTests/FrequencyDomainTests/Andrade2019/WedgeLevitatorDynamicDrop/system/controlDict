FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     interFALFlow;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          1e-6;

writeControl    runTime;

writeInterval   1e-6;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  off;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       2e-6;

maxCapillaryNum 50;

functions
{
    dropGeometry
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            dropGeometry;
        writeControl    writeTime;
        writeInterval   1;

        codeInclude
        #{
            #include "PstreamReduceOps.H"
            #include "reconstructionSchemes.H"
        #};

        codeOptions
        #{
            -I/home/cx80jevu/TwoPhaseFlow/src/VoF/lnInclude
        #};

        codeLibs
        #{
            -L$(FOAM_USER_LIBBIN) \
            -lVoF \
            -lfiniteVolume
        #};

        codeWrite
        #{
            const volScalarField& alpha =
                mesh().lookupObject<volScalarField>("alpha.water");

            scalar localPlicXMax = -GREAT;
            bool havePlicXMax = false;

            if (mesh().foundObject<reconstructionSchemes>("reconstructionScheme"))
            {
                reconstructionSchemes& surf =
                    mesh().lookupObjectRef<reconstructionSchemes>
                    (
                        "reconstructionScheme"
                    );

                // Refresh only if needed; reconstructionSchemes already
                // caches by time index / iteration.
                surf.reconstruct(false);

                const volVectorField& interfaceCentres = surf.centre();
                const DynamicField<label>& interfaceLabels =
                    surf.interfaceLabels();

                forAll(interfaceLabels, i)
                {
                    const label celli = interfaceLabels[i];
                    const vector& plicCentre = interfaceCentres[celli];

                    if (mag(plicCentre) > SMALL)
                    {
                        localPlicXMax = max(localPlicXMax, plicCentre.x());
                        havePlicXMax = true;
                    }
                }
            }

            const scalarField& V = mesh().V();
            const vectorField& C = mesh().C();

            scalar localWeightedVol = 0.0;
            scalar localYMoment = 0.0;
            label localSelected = 0;
            scalar localXMax = -GREAT;
            scalar localYMin = GREAT;
            scalar localYMax = -GREAT;

            forAll(alpha, celli)
            {
                const scalar alphaVal = alpha[celli];
                const scalar weight = max(min(alphaVal, scalar(1)), scalar(0));

                localWeightedVol += weight*V[celli];
                localYMoment += weight*V[celli]*C[celli].y();

                if (alphaVal > 0.5)
                {
                    ++localSelected;

                    localXMax = max(localXMax, C[celli].x());
                    localYMin = min(localYMin, C[celli].y());
                    localYMax = max(localYMax, C[celli].y());
                }
            }

            scalar weightedVol = localWeightedVol;
            scalar yMoment = localYMoment;
            label selected = localSelected;
            scalar xMax = localXMax;
            scalar yMin = localYMin;
            scalar yMax = localYMax;
            scalar plicXMax = localPlicXMax;
            label plicDefined = havePlicXMax ? 1 : 0;

            reduce(weightedVol, sumOp<scalar>());
            reduce(yMoment, sumOp<scalar>());
            reduce(selected, sumOp<label>());
            reduce(xMax, maxOp<scalar>());
            reduce(yMin, minOp<scalar>());
            reduce(yMax, maxOp<scalar>());
            reduce(plicXMax, maxOp<scalar>());
            reduce(plicDefined, sumOp<label>());

            if (!Pstream::master())
            {
                return true;
            }

            const fileName outputDir
            (
                mesh().time().globalPath()/functionObject::outputPrefix/"dropGeometry"
            );
            mkDir(outputDir);

            const fileName outputFile(outputDir/"geometry.dat");
            const bool newFile = !exists(outputFile);

            if (newFile)
            {
                OFstream header(outputFile);
                header
                    << "# time\tcenterY\thorizontalAxis\tverticalAxis\txMax\tyMin\tyMax\tweightedVolume\tselectedCells"
                    << nl;
            }

            OFstream os(outputFile, IOstreamOption(), IOstreamOption::APPEND);

            const scalar centerY =
                weightedVol > SMALL ? yMoment/weightedVol : 0.0;
            const scalar horizontalAxis =
                plicDefined > 0 ? plicXMax : (selected > 0 ? xMax : 0.0);
            const scalar verticalAxis = selected > 0 ? yMax - yMin : 0.0;
            const scalar reportedXMax = horizontalAxis;

            os  << mesh().time().value() << tab
                << centerY << tab
                << horizontalAxis << tab
                << verticalAxis << tab
                << reportedXMax << tab
                << (selected > 0 ? yMin : 0.0) << tab
                << (selected > 0 ? yMax : 0.0) << tab
                << weightedVol << tab
                << selected
                << nl;

            return true;
        #};
    }
}


