#!/bin/sh
set -e
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
. ./caseParams.sh                                   # Case parameters
#------------------------------------------------------------------------------

need_cmd()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: required command '$1' not found in PATH" >&2
        exit 1
    fi
}

ensure_solver()
{
    solverName="$1"
    solverDir="$2"
    if command -v "${solverName}" >/dev/null 2>&1; then
        return 0
    fi

    echo "Solver '${solverName}' not found, building ${solverDir} ..."
    repoRoot="$(cd ../../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "solver/${solverDir}"
    )

    if ! command -v "${solverName}" >/dev/null 2>&1; then
        echo "Error: solver '${solverName}' is still unavailable after build." >&2
        exit 1
    fi
}

ensure_app()
{
    appName="$1"
    appDir="$2"
    if command -v "${appName}" >/dev/null 2>&1; then
        return 0
    fi

    echo "Application '${appName}' not found, building ${appDir} ..."
    repoRoot="$(cd ../../../../../ && pwd)"
    (
        cd "${repoRoot}" || exit 1
        wmake "${appDir}"
    )

    if ! command -v "${appName}" >/dev/null 2>&1; then
        echo "Error: application '${appName}' is still unavailable after build." >&2
        exit 1
    fi
}

case "${MESH_BACKEND:-cfmesh}" in
    cfmesh)
        need_cmd cartesian2DMesh
        need_cmd extrudeMesh
        ;;
    gmsh)
        need_cmd gmsh
        ;;
    *)
        echo "Error: unsupported MESH_BACKEND='${MESH_BACKEND}'" >&2
        echo "Use MESH_BACKEND=cfmesh or MESH_BACKEND=gmsh." >&2
        exit 1
        ;;
esac

if [ -z "${NPROCS:-}" ]; then
    NPROCS="$(awk '/^[[:space:]]*numberOfSubdomains[[:space:]]+/ {gsub(/;/, "", $2); print $2; exit}' system/decomposeParDict)"
fi
: "${NPROCS:=8}"

./Allclean
./prepareCase

case "${MESH_BACKEND:-cfmesh}" in
    cfmesh)
        runApplication cartesian2DMesh
        runApplication extrudeMesh
        ./postMesh
        ;;
    gmsh)
        gmsh -0 constant/levitatorWedgeHex.geo
        runApplication gmshToFoam constant/levitatorWedgeHex.msh
        rm constant/levitatorWedgeHex.msh
        runApplication changeDictionary
        ;;
esac

restore0Dir
runApplication setAlphaField
rm -f 0/Pim.in

ensure_app setPMLFields apps/utilities/mesh/setPMLFields
runApplication setPMLFields

ensure_solver "${SOLVER}" interFALFlow
rm -f "log.${SOLVER}"
runApplication decomposePar -force
runParallel "${SOLVER}"
runApplication reconstructPar -latestTime

#------------------------------------------------------------------------------
