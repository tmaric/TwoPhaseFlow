/*--------------------------------*- C++ -*----------------------------------*\
| =========                 |                                                 |
| \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox           |
|  \\    /   O peration     | Version:  2.0.1                                 |
|   \\  /    A nd           | Web:      www.OpenFOAM.com                      |
|    \\/     M anipulation  |                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticHelmholtzFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    runTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

libs
(
   "libpetscFoam.so"
);

functions
{
    reflectorForce
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            reflectorForce;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;

        codeWrite
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volScalarField& pr = mesh.lookupObject<volScalarField>("pr");

            const label patchID = mesh.boundaryMesh().findPatchID("reflector1");
            if (patchID < 0)
            {
                FatalErrorInFunction
                    << "Patch 'reflector1' not found."
                    << exit(FatalError);
            }

            const auto& Sf = mesh.Sf().boundaryField()[patchID];
            const auto& pB = pr.boundaryField()[patchID];
            const vector forceVec = gSum(pB*Sf);
            const vector areaVec = gSum(Sf);
            const vector nHat = areaVec/(mag(areaVec) + VSMALL);
            const scalar Fn = (forceVec & nHat);

            if (Pstream::master())
            {
                const fileName outDir
                (
                    mesh.time().globalPath()/"postProcessing"/"reflectorForce"
                );
                mkDir(outDir);
                const fileName outFile(outDir/"force.dat");
                const bool writeHeader = !exists(outFile);

                OFstream os(outFile, IOstreamOption(), IOstreamOption::APPEND);
                if (writeHeader)
                {
                    os  << "# time"
                        << tab << "Fn" << nl;
                }
                os  << mesh.time().timeName()
                    << tab << Fn << nl;
            }
        #};
    }

    dropRadiationForce
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            dropRadiationForce;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;

        codeInclude
        #{
            #include "fvcGrad.H"
            #include "volFields.H"
        #};

        codeWrite
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volScalarField& alpha1 =
                mesh.lookupObject<volScalarField>("alpha.water");
            const volScalarField& pr =
                mesh.lookupObject<volScalarField>("pr");
            const volVectorField& interfaceArea =
                mesh.lookupObject<volVectorField>("interfaceNormal.water");
            const volVectorField& interfaceCentre =
                mesh.lookupObject<volVectorField>("interfaceCentre.water");

            const tmp<volVectorField> tGradPr =
                fvc::grad(pr, "grad(pr)");
            const volVectorField& gradPr = tGradPr();

            vector forceSlice = Zero;
            scalar interfaceAreaSlice = 0.0;
            scalar wetVolumeSlice = 0.0;
            label interfaceCells = 0;

            const vectorField& C = mesh.C();
            const scalarField& V = mesh.V();

            forAll(pr, celli)
            {
                const scalar alpha = alpha1[celli];
                wetVolumeSlice += alpha*V[celli];

                const vector Sint = interfaceArea[celli];
                if (mag(Sint) <= VSMALL)
                {
                    continue;
                }

                ++interfaceCells;
                interfaceAreaSlice += mag(Sint);

                const vector dx = interfaceCentre[celli] - C[celli];
                const scalar prInt = pr[celli] + (gradPr[celli] & dx);

                forceSlice += prInt*Sint;
            }

            reduce(forceSlice, sumOp<vector>());
            reduce(interfaceAreaSlice, sumOp<scalar>());
            reduce(wetVolumeSlice, sumOp<scalar>());
            reduce(interfaceCells, sumOp<label>());

            const scalar axisymScale = 360.0/(__WEDGE_DEG__ + VSMALL);
            const vector forceAxisym = axisymScale*forceSlice;
            const scalar interfaceAreaAxisym = axisymScale*interfaceAreaSlice;
            const scalar wetVolumeAxisym = axisymScale*wetVolumeSlice;

            if (Pstream::master())
            {
                const fileName outDir
                (
                    mesh.time().globalPath()/"postProcessing"/"dropRadiationForce"
                );
                mkDir(outDir);
                const fileName outFile(outDir/"force.dat");
                const bool writeHeader = !exists(outFile);

                OFstream os(outFile, IOstreamOption(), IOstreamOption::APPEND);
                if (writeHeader)
                {
                    os  << "# time"
                        << tab << "FxSlice"
                        << tab << "FySlice"
                        << tab << "FzSlice"
                        << tab << "FyAxisym"
                        << tab << "interfaceAreaSlice"
                        << tab << "interfaceAreaAxisym"
                        << tab << "wetVolumeSlice"
                        << tab << "wetVolumeAxisym"
                        << tab << "scaleFactor"
                        << tab << "nInterfaceCells" << nl;
                }

                os  << mesh.time().timeName()
                    << tab << forceSlice.x()
                    << tab << forceSlice.y()
                    << tab << forceSlice.z()
                    << tab << forceAxisym.y()
                    << tab << interfaceAreaSlice
                    << tab << interfaceAreaAxisym
                    << tab << wetVolumeSlice
                    << tab << wetVolumeAxisym
                    << tab << axisymScale
                    << tab << interfaceCells << nl;
            }
        #};
    }

    gorkovPrediction
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            gorkovPrediction;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;

        codeInclude
        #{
            #include "fvcGrad.H"
            #include "interpolationCellPoint.H"
            #include "volFields.H"
        #};

        codeWrite
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volScalarField& Pre = mesh.lookupObject<volScalarField>("Pre");
            const volScalarField& Pim = mesh.lookupObject<volScalarField>("Pim");
            const volVectorField& Ure = mesh.lookupObject<volVectorField>("Ure");
            const volVectorField& Uim = mesh.lookupObject<volVectorField>("Uim");

            const scalar rhoHost = __RHOG__;
            const scalar cHost = __CG__;
            const scalar rhoParticle = __RHOL__;
            const scalar cParticle = __CL__;
            const scalar kappaHost = 1.0/(rhoHost*cHost*cHost);
            const scalar kappaParticle = 1.0/(rhoParticle*cParticle*cParticle);
            const scalar f1 = 1.0 - kappaParticle/kappaHost;
            const scalar f2 =
                2.0*(rhoParticle - rhoHost)/(2.0*rhoParticle + rhoHost);

            volScalarField Ep
            (
                IOobject
                (
                    "EpGorkov",
                    mesh.time().timeName(),
                    mesh,
                    IOobject::NO_READ,
                    IOobject::NO_WRITE
                ),
                0.25*kappaHost*(Pre*Pre + Pim*Pim)
            );

            volScalarField Ek
            (
                IOobject
                (
                    "EkGorkov",
                    mesh.time().timeName(),
                    mesh,
                    IOobject::NO_READ,
                    IOobject::NO_WRITE
                ),
                0.25*rhoHost*(magSqr(Ure) + magSqr(Uim))
            );

            const tmp<volVectorField> tGradEp =
                fvc::grad(Ep, "grad(EpGorkov)");
            const volVectorField& gradEp = tGradEp();

            const tmp<volVectorField> tGradEk =
                fvc::grad(Ek, "grad(EkGorkov)");
            const volVectorField& gradEk = tGradEk();

            const point samplePt(__AXIS_RADIUS__ + 1e-9, __DROP_CENTER_Y__, 1e-9);
            const label sampleCell = mesh.findCell(samplePt);

            interpolationCellPoint<scalar> interpEp(Ep);
            interpolationCellPoint<scalar> interpEk(Ek);
            interpolationCellPoint<vector> interpGradEp(gradEp);
            interpolationCellPoint<vector> interpGradEk(gradEk);

            label sampleFound = 0;
            scalar EpPt = 0.0;
            scalar EkPt = 0.0;
            vector gradEpPt = Zero;
            vector gradEkPt = Zero;

            if (sampleCell >= 0)
            {
                sampleFound = 1;
                EpPt = interpEp.interpolate(samplePt, sampleCell, -1);
                EkPt = interpEk.interpolate(samplePt, sampleCell, -1);
                gradEpPt = interpGradEp.interpolate(samplePt, sampleCell, -1);
                gradEkPt = interpGradEk.interpolate(samplePt, sampleCell, -1);
            }

            reduce(sampleFound, sumOp<label>());
            reduce(EpPt, sumOp<scalar>());
            reduce(EkPt, sumOp<scalar>());
            reduce(gradEpPt, sumOp<vector>());
            reduce(gradEkPt, sumOp<vector>());

            if (sampleFound <= 0)
            {
                FatalErrorInFunction
                    << "Could not locate Gorkov sample point " << samplePt
                    << " in the mesh."
                    << exit(FatalError);
            }

            if (Pstream::master())
            {
                const fileName outDir
                (
                    mesh.time().globalPath()/"postProcessing"/"gorkovPrediction"
                );
                mkDir(outDir);

                const fileName pointFile(outDir/"pointData.dat");
                const bool writePointHeader = !exists(pointFile);
                OFstream pos(pointFile, IOstreamOption(), IOstreamOption::APPEND);

                if (writePointHeader)
                {
                    pos << "# time"
                        << tab << "x"
                        << tab << "y"
                        << tab << "z"
                        << tab << "Ep"
                        << tab << "Ek"
                        << tab << "gradEpx"
                        << tab << "gradEpy"
                        << tab << "gradEpz"
                        << tab << "gradEkx"
                        << tab << "gradEky"
                        << tab << "gradEkz"
                        << tab << "f1"
                        << tab << "f2" << nl;
                }

                pos << mesh.time().timeName()
                    << tab << samplePt.x()
                    << tab << samplePt.y()
                    << tab << samplePt.z()
                    << tab << EpPt
                    << tab << EkPt
                    << tab << gradEpPt.x()
                    << tab << gradEpPt.y()
                    << tab << gradEpPt.z()
                    << tab << gradEkPt.x()
                    << tab << gradEkPt.y()
                    << tab << gradEkPt.z()
                    << tab << f1
                    << tab << f2 << nl;

                const scalar radii[] =
                {
                    20e-6,
                    40e-6,
                    60e-6,
                    80e-6,
                    100e-6
                };

                const fileName forceFile(outDir/"force.dat");
                const bool writeForceHeader = !exists(forceFile);
                OFstream fos(forceFile, IOstreamOption(), IOstreamOption::APPEND);

                if (writeForceHeader)
                {
                    fos << "# time"
                        << tab << "radius_um"
                        << tab << "Fgx"
                        << tab << "Fgy"
                        << tab << "Fgz" << nl;
                }

                for (const scalar radius : radii)
                {
                    const scalar volume =
                        4.0*constant::mathematical::pi*pow3(radius)/3.0;
                    const vector force =
                        -volume*(f1*gradEpPt - 1.5*f2*gradEkPt);

                    fos << mesh.time().timeName()
                        << tab << radius/1e-6
                        << tab << force.x()
                        << tab << force.y()
                        << tab << force.z() << nl;
                }
            }
        #};
    }
}
