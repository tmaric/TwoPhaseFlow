FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom patch;
sourceCase    ".";

sourcePatches (bottomEmptyFaces);
exposedPatchName topEmptyFaces;

extrudeModel    wedge;

sectorCoeffs
{
    point       (0 0 0);
    axis        (0 -1 0);
    angle       __WEDGE_DEG__;
}

flipNormals true;

mergeFaces false;

// ************************************************************************* //
