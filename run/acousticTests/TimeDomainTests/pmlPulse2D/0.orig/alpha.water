/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}

dimensions      [0 0 0 0 0 0 0];

// Gas everywhere; setAlphaField adds a drop when DROP_RADIUS > 0.
internalField   uniform 0;

boundaryField
{
    walls        { type zeroGradient; }
    frontAndBack { type empty; }
}
