#!/bin/sh
set -e
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
. ./caseParams.sh

./Allclean
restore0Dir
./prepareCase

runApplication blockMesh
runApplication setExprFields
if [ "$(awk "BEGIN { print ($DROP_RADIUS > 0) }")" = 1 ]
then
    runApplication setAlphaField
fi
runApplication setPMLFields
# A run that blows up is still post-processed up to its last finite sample.
runApplication "${SOLVER}" || echo "${SOLVER} failed; see log.${SOLVER}"

python3 postprocess_pml.py > log.postprocess 2>&1
tail -n 15 log.postprocess
