/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

// Generated by prepareCase from setExprFieldsDict.in.
// alpha.water: exact volume fraction of a planar interface at x_I.
// p: exact two-layer eigenmode at t = 0 (pDot = U = 0), sampled at the
// cell centres.

expressions
(
    alpha
    {
        field       alpha.water;
        // Round-off from the subtraction is snapped to exactly 0 or 1.
        variables
        (
            "frac = (pos().x() + 0.5*__H__ - __XI__)/__H__"
        );
        expression
        #{
            (frac < 1e-9) ? 0 : ((frac > 1 - 1e-9) ? 1 : frac)
        #};
    }

    p
    {
        field       p;
        expression
        #{
            (pos().x() < __XI__)
          ? __A__*cos(__KG__*pos().x())
          : __B__*cos(__KL__*(__L__ - pos().x()))
        #};
    }
);
