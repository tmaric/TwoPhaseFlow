#!/bin/sh
set -e
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
. ./caseParams.sh

./Allclean
./prepareCase
restore0Dir

runApplication blockMesh
runApplication setExprFields

if [ "$NPROCS" -gt 1 ]
then
    runApplication decomposePar -force
    runParallel "${SOLVER}"
    runApplication reconstructPar -latestTime -fields '(invRhof alphaf)'
else
    runApplication "${SOLVER}"
fi

python3 postprocess_two_layer.py > log.postprocess 2>&1
tail -n 25 log.postprocess
if [ "$RADIATION_CHECK" = 1 ]
then
    python3 postprocess_radiation.py > log.radiation 2>&1
    tail -n 20 log.radiation
fi
