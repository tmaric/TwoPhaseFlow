FoamFile
{
    version     2.0;
    format      ascii;
    class       volTensorField;
    object      sigma;
}

dimensions      [0 0 -1 0 0 0 0];

// No PML: all damping rates are zero.
internalField   uniform (0 0 0 0 0 0 0 0 0);

boundaryField
{
    walls        { type calculated; value $internalField; }
    frontAndBack { type empty; }
}
