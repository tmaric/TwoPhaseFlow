FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

// Generated by prepareCase from setExprFieldsDict.in.
// Consistent start of the standing mode: p = PA cos(k x), pDot = U = 0.

expressions
(
    p
    {
        field       p;
        expression  #{ __PA__*cos(__K__*pos().x()) #};
    }
);
