/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

// Generated by prepareCase from transportProperties.in.

// Liquid entries are required by the solver but unused: alpha = 0.
rhol            998.2;
cl              1482;
rhog            __RHOG__;
cg              __CG__;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};

// Mode frequency; also sets the radiation averaging window.
f               __DRIVE_F__;
radiationAveragePeriods __RADIATION_PERIODS__;

timeIntegrationMethod __TIME_METHOD__;
timeIntegrationTheta  __THETA__;
timeBlockLinearSolver __BLOCK_SOLVER__;
acousticDampingRate   0;
