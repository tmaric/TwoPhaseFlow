#!/bin/sh
set -e
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
. ./caseParams.sh

./Allclean
./prepareCase
restore0Dir

runApplication blockMesh
runApplication setExprFields
runApplication "${SOLVER}"

python3 postprocess_cavity.py > log.postprocess 2>&1
tail -n 20 log.postprocess
if [ "$RADIATION_CHECK" = 1 ]
then
    python3 postprocess_radiation.py > log.radiation 2>&1
    tail -n 20 log.radiation
fi
