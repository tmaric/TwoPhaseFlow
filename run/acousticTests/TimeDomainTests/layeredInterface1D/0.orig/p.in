/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

pistonFrequency __DRIVE_F__;
pistonVelocity  __PISTON_U__;

boundaryField
{
    left
    {
        type                uniformFixedGradient;
        uniformGradient     cosine;
        uniformGradientCoeffs
        {
            frequency       constant $pistonFrequency;
            scale           constant #eval{-$pistonVelocity*2*pi()*$pistonFrequency};
            level           constant 0;
        }
        value               $internalField;
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
