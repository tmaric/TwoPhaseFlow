/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    left
    {
        type                uniformFixedGradient;
        uniformGradient     cosine;
        uniformGradientCoeffs
        {
            frequency       constant 20000;
            scale           constant #eval{-1.2*0.01*2*pi()*20000};
            level           constant 0;
        }
        value               $internalField;
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
