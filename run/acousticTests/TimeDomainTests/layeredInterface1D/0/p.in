/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    left
    {
        type                uniformFixedGradient;
        uniformGradient     cosine;
        uniformGradientCoeffs
        {
            frequency       constant __DRIVE_F__;
            scale           constant #eval{-__RHOG__*__PISTON_U__*2*pi()*__DRIVE_F__};
            level           constant 0;
        }
        value               $internalField;
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
