/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

pistonFrequency __DRIVE_F__;
pistonVelocity  __PISTON_U__;
gasDensity      __RHOG__;
soundSpeed      __CG__;

boundaryField
{
    left
    {
        type                uniformFixedValue;
        uniformValue        sine;
        uniformValueCoeffs
        {
            frequency       constant $pistonFrequency;
            scale           constant #eval{$gasDensity*$soundSpeed*$pistonVelocity};
            level           constant 0;
        }
        value               $internalField;
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
