/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     acousticWaveFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.001;
deltaT          1e-06;

writeControl    runTime;
writeInterval   1e-5;
purgeWrite      0;
writeFormat     binary;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  no;

functions
{
    lineProbes
    {
        type            probes;
        libs            (sampling);
        writeControl    runTime;
        writeInterval   2.5e-06;
        fields          (p);
        probeLocations
        (
            (0.050 0 0)
            (0.080 0 0)
            (0.100 0 0)
            (0.140 0 0)
            (0.220 0 0)
        );
    }
}
