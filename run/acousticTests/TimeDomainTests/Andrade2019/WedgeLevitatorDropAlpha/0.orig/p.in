FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0]; 

internalField   uniform 0;

boundaryField
{
   openAir
    {
         type            zeroGradient;
    }

    transducer1
    {
             type            uniformFixedGradient;
             uniformGradient     cosine;
             uniformGradientCoeffs
          {
              frequency       constant __DRIVE_F__;
              scale           constant #eval{-__RHOG__*__PISTON_U__*2*pi()*__DRIVE_F__};
              level           constant 0;
          }
          value           $internalField;
    }
    "(transducer2|reflector2|reflector1)"
    {
        type            zeroGradient;
    }
    axis
    {
        type            symmetryPlane;
    }
    "(front|back)"
    {
        type            wedge;
    }
}

// ************************************************************************* //
