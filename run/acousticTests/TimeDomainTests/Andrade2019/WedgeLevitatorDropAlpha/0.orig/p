FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0]; 

internalField   uniform 0;

boundaryField
{
   openAir
    {
         type            acousticWaveTransmissive;
         advectiveSpeed  343;
         value           $internalField;

    }

    transducer1
    {
             type            uniformFixedGradient;
             uniformGradient     cosine;
             uniformGradientCoeffs
          {
              frequency       constant 25250;
              scale           constant #eval{-1.2*2*pi()*25250};
              level           constant 0;
          }
          value           $internalField;
    }
    "(transducer2|reflector2|reflector1)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}

