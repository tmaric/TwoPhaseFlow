FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticWaveFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5e-3;

deltaT          5e-7;

writeControl    runTime;

writeInterval   5e-6;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.25;

maxDeltaT       5e-6;

// ************************************************************************* //

#include "FOforce"
functions
{
// #includeFunc mag(U)

fieldMinMax
{
    // Mandatory entries (unmodifiable)
    type        fieldMinMax;
    libs        (fieldFunctionObjects);

    // Mandatory entries (runtime modifiable)
    mode        magnitude;
    fields      (U p pr);

    // Optional entries (runtime modifiable)
    location    no;
/*
    // Optional (inherited) entries
    writePrecision  8;
    writeToFile     true;
    useUserTime     true;
    region          region0;
    enabled         true;
    log             true;
    timeStart       0;
    timeEnd         1000;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    timeStep;
    writeInterval   1;*/
}

probes
{
    type                probes;
    libs                (sampling);
    probeLocations      ((0.001 0.0036 0) (0.004 0.0036 0) (0.007 0.0036 0) (0.004 0.006 0) (0.004 0.0012 0));
    fields              (pr p U);
}
}
