FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticTDSPMLFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         200e-3; // 2e-7; //50e-6;

deltaT          1e-7; 

writeControl    runTime; //timeStep;

writeInterval   1e-4; //#eval{1.0*10/25250}; //1000; //5; //1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.25;

maxDeltaT       5e-6;

// ************************************************************************* //

#include "FOforce"
functions
{
    fieldAverage1
    {
        type            fieldAverage;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
//        enabled         false;
//		  cleanRestart		true;
        writeControl   writeTime;
//        outputControl   outputTime;
//        outputInterval  1;
        fields
        (
            U
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            /*p_rgh
            {
                mean        on;
                prime2Mean  on;
                base        time;
            }*/
        );
    }

    ARFAverage
    {
        type            fieldAverage;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
//        enabled         false;
//                cleanRestart          true;
        writeControl   writeTime;
//        outputControl   outputTime;
//        outputInterval  1;
        fields
        (
            prT
            {
                mean            on;
                prime2Mean      off;
               base            time;
               windowType      approximate;
                window          #eval{5/25250};
                //windowName      movingAverageWindow;
                allowRestart    no;
            }

            momFluxT
            {
                mean            on;
                prime2Mean      off;
                base            time;
                windowType      approximate;
                window          #eval{5/25250};
                //windowName      movingAverageWindow;
                allowRestart    no;
            }

        );
    }

// #includeFunc mag(U)

fieldMinMax
{
    // Mandatory entries (unmodifiable)
    type        fieldMinMax;
    libs        (fieldFunctionObjects);

    // Mandatory entries (runtime modifiable)
    mode        magnitude;
    fields      (U p pr);

    // Optional entries (runtime modifiable)
    location    no;
