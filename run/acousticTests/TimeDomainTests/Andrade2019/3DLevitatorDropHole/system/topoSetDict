FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Geometry constants (from levitator3D.geo)
// rT=0.01, rR=0.019, bu=0.01, hS=0.01, D=0.00744, s=0.004, r=0.001
// Rdom = rR + bu = 0.029
// yMin = -hS = -0.01, yMax = D + hS = 0.01744

actions
(
    // All boundary faces
    {
        name    allBoundary;
        type    faceSet;
        action  new;
        source  boundaryToFace;
    }

    // Transducer face (disk at y = 0, radius rT)
    {
        name    transducer1;
        type    faceSet;
        action  new;
        source  boxToFace;
        sourceInfo
        {
            box ((-0.0101 -0.0001 -0.0101) (0.0101 0.0001 0.0101));
        }
    }
    {
        name    transducer1;
        type    faceSet;
        action  subset;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }

    // Reflector face (disk at y = D, radius rR)
    {
        name    reflector1;
        type    faceSet;
        action  new;
        source  boxToFace;
        sourceInfo
        {
            box ((-0.0191 0.00734 -0.0191) (0.0191 0.00754 0.0191));
        }
    }
    {
        name    reflector1;
        type    faceSet;
        action  subset;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }

    // Drop cavity (sphere)
    {
        name    dropWall;
        type    faceSet;
        action  new;
        source  sphereToFace;
        sourceInfo
        {
            centre (0 0.004 0);
            radius 0.00105;
        }
    }
    {
        name    dropWall;
        type    faceSet;
        action  subset;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }

    // Transducer side wall (bottom cavity cylinder wall, radius rR)
    {
        name    transducer2;
        type    faceSet;
        action  new;
        source  cylinderToFace;
        sourceInfo
        {
            p1 (0 -0.01 0);
            p2 (0 0 0);
            radius 0.01905;
        }
    }
    {
        name    transducer2;
        type    faceSet;
        action  subset;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }

    // Reflector side wall (top cavity cylinder wall, radius rT)
    {
        name    reflector2;
        type    faceSet;
        action  new;
        source  cylinderToFace;
        sourceInfo
        {
            p1 (0 0.00744 0);
            p2 (0 0.01744 0);
            radius 0.01005;
        }
    }
    {
        name    reflector2;
        type    faceSet;
        action  subset;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }

    // Open air = allBoundary minus other patches
    {
        name    openAir;
        type    faceSet;
        action  new;
        source  faceToFace;
        sourceInfo
        {
            set allBoundary;
        }
    }
    {
        name    openAir;
        type    faceSet;
        action  subtract;
        source  faceToFace;
        sourceInfo
        {
            set transducer1;
        }
    }
    {
        name    openAir;
        type    faceSet;
        action  subtract;
        source  faceToFace;
        sourceInfo
        {
            set transducer2;
        }
    }
    {
        name    openAir;
        type    faceSet;
        action  subtract;
        source  faceToFace;
        sourceInfo
        {
            set reflector1;
        }
    }
    {
        name    openAir;
        type    faceSet;
        action  subtract;
        source  faceToFace;
        sourceInfo
        {
            set reflector2;
        }
    }
    {
        name    openAir;
        type    faceSet;
        action  subtract;
        source  faceToFace;
        sourceInfo
        {
            set dropWall;
        }
    }
);

