FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;
mergeTolerance  1e-6;

geometry
{
    levitator_openAir.stl
    {
        type triSurfaceMesh;
        name openAir;
    }
    levitator_transducer1.stl
    {
        type triSurfaceMesh;
        name transducer1;
    }
    levitator_transducer2.stl
    {
        type triSurfaceMesh;
        name transducer2;
    }
    levitator_reflector1.stl
    {
        type triSurfaceMesh;
        name reflector1;
    }
    levitator_reflector2.stl
    {
        type triSurfaceMesh;
        name reflector2;
    }
    levitator_dropWall.stl
    {
        type triSurfaceMesh;
        name dropWall;
    }
}

castellatedMeshControls
{
    maxLocalCells  500000;
    maxGlobalCells 1500000;
    // Allow small internal surfaces to survive refinement
    minRefinementCells 0;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels 2;
    resolveFeatureAngle 30;

    features ();

    refinementSurfaces
    {
        openAir
        {
            level (1 1);
            patchInfo { type patch; }
        }
        transducer1
        {
            level (1 2);
            patchInfo { type wall; }
        }
        transducer2
        {
            level (1 2);
            patchInfo { type wall; }
        }
        reflector1
        {
            level (1 2);
            patchInfo { type wall; }
        }
        reflector2
        {
            level (1 2);
            patchInfo { type wall; }
        }
        dropWall
        {
            level (2 2);
            faceZone dropWallZone;
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
        // Force extra refinement around the internal sphere so it intersects the mesh
        dropWall
        {
            mode distance;
            levels ((0.0015 3) (0.003 2));
        }
    }

    locationInMesh (0 0.001 0);
    // Keep internal faces from the dropWall zone for createBaffles
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 1.0;
    nSolveIter 25;
    nRelaxIter 3;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nBufferCellsNoExtrude 0;
}

meshQualityControls
{
    maxNonOrtho 75;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-15;
    minTetQuality 1e-9;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

