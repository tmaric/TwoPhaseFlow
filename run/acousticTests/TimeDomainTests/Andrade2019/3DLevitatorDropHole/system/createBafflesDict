FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Whether to convert internal faces only (so leave boundary faces intact).
internalFacesOnly true;
noFields true;

// Convert the internal dropWall faceZone created by snappy into baffles
baffles
{
    dropWall
    {
        //- Use predefined faceZone to select faces and orientation.
        type        faceZone;
        zoneName    dropWallZone;

        // Create dropWall_master / dropWall_slave patches
        patchPairs
        {
            type wall;
        }
    }
}

