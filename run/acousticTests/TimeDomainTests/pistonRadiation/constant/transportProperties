FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] 1.2;
R               1.51e-3;
p0              0.0;

rhol            998.3;
rhog            1.2;
cg              343;
cl              1480;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};
laplacianCorrection 1.0;
timeIntegrationTheta 0.5;

pistonRadius    0.1;
domainRadius    0.2;
pmlThickness    0.08;

f               10000;
cellsPerLambda  60;
wl              #eval{$cg/$f};
cellSize        #eval{$wl/$cellsPerLambda};

PMLType         spherical;
L               $pmlThickness;
origin          (0 0 0);
Rmin            $domainRadius;
Rmax            #eval{$domainRadius + $pmlThickness};
sigmaMax        100000;
po              3;

