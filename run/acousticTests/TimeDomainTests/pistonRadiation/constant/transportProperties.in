/*--------------------------------*- C++ -*----------------------------------*\
| =========                 |                                                 |
| \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox           |
|   \\/     M anipulation  |                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

transportModel  Newtonian;

mu              [ 1 -1 -1 0 0 0 0 ] 0.0;
psi             [ 0 -2 2 0 0 0 0 ] 8.5e-6;
rho0            [ 1 -3 0 0 0 0 0 ] __RHOG__;
R               1.51e-3;
p0              0.0;

rhol            __RHOL__;
rhog            __RHOG__;
cg              __CG__;
cl              __CL__;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};
laplacianCorrection 1.0;

pistonRadius    __PISTON_RADIUS__;
domainRadius    __PML_RMIN__;
pmlThickness    __PML_L__;

f               __DRIVE_F__;
cellsPerLambda  __MESH_CELLS_PER_LAMBDA__;
wl              #eval{$cg/$f};
cellSize        #eval{$wl/$cellsPerLambda};

PMLType         spherical;
L               $pmlThickness;
origin          (0 0 0);
Rmin            $domainRadius;
Rmax            #eval{$domainRadius + $pmlThickness};
sigmaMax        100000;
po              3;

// ************************************************************************* //
