FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

vertices
(
    (0 0 0)
    (__OUTER_X__ 0 __OUTER_Z__)
    (__OUTER_X__ 0 -__OUTER_Z__)
    (0 __PML_RMAX__ 0)
    (__OUTER_X__ __PML_RMAX__ __OUTER_Z__)
    (__OUTER_X__ __PML_RMAX__ -__OUTER_Z__)
);

blocks
(
    hex (0 3 4 1 0 3 5 2)
        (__N_AXIAL__ __N_RADIAL__ 1)
        simpleGrading (__MESH_GR__ __MESH_GR__ 1)
);

edges
(
);

boundary
(
    axis
    {
        type empty;
        faces
        (
            (0 3 3 0)
        );
    }

    bottom
    {
        type patch;
        faces
        (
            (0 1 2 0)
        );
    }

    openAir
    {
        type patch;
        faces
        (
            (1 4 5 2)
            (3 5 4 3)
        );
    }

    front
    {
        type wedge;
        faces
        (
            (0 1 4 3)
        );
    }

    back
    {
        type wedge;
        faces
        (
            (0 3 5 2)
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
