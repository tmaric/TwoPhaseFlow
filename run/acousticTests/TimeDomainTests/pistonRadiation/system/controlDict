FoamFile
{
    version     2;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     acousticWaveFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.0025;
deltaT          1e-6;

writeControl    runTime;
writeInterval   0.00001;
purgeWrite      0;
writeFormat     binary;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  no;

functions
{
    verificationProbes
    {
        type            probes;
        libs            (sampling);
        writeControl    runTime;
        writeInterval   2e-06;
        fields          (p);
        probeLocations
        (
            #include "verificationProbesLocations"
        );
    }
}

