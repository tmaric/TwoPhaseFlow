FoamFile
{
    version     2;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     __SOLVER__;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         __END_TIME__;
deltaT          1e-6;

writeControl    runTime;
writeInterval   __WRITE_INTERVAL__;
purgeWrite      0;
writeFormat     binary;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  no;

functions
{
    verificationProbes
    {
        type            probes;
        libs            (sampling);
        writeControl    runTime;
        writeInterval   __PROBE_INTERVAL__;
        fields          (p);
        probeLocations
        (
            #include "verificationProbesLocations"
        );
    }
}

