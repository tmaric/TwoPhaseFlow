FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}

actions
(
    {
        name piston;
        type faceSet;
        action new;
        source patchToFace;
        sourceInfo { patch bottom; }
    }
    {
        name piston;
        type faceSet;
        action subset;
        source cylinderToFace;
        sourceInfo
        {
            p1 (0 -0.0001 0);
            p2 (0  0.0001 0);
            radius __PISTON_RADIUS__;
        }
    }
);

// ************************************************************************* //
