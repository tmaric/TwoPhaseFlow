/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Written to 0/p by prepareCase. The piston at x = 0 moves with U_p(t) in +x;
// along the outward normal (-x), dp/dn = rho1 dU_p/dt. The far end is sound
// hard.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            uniformFixedGradient;
        uniformGradient
        {
            type        expression;
            expression  #{ __DRIVE_EXPRESSION__ #};
        }
        value           uniform 0;
    }
    right { type zeroGradient; }
    yMin  { type empty; }
    yMax  { type empty; }
    zMin  { type empty; }
    zMax  { type empty; }
}
