/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// Generated by prepareCase from controlDict.in.

application     __SOLVER__;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         __END_TIME__;
deltaT          __DELTA_T__;

// Full fields only at the start and the end; histories come from the probes.
writeControl    runTime;
writeInterval   __END_TIME__;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   12;
runTimeModifiable no;
adjustTimeStep  no;

functions
{
    cellProbes
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   __PROBE_STRIDE__;
        writePrecision  12;
        fields          (p U);
        #include        "probeLocations"
    }
}
