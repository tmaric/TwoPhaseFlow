/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

// Generated by prepareCase from transportProperties.in.

rhol            __RHOL__;
cl              __CL__;
rhog            __RHOG__;
cg              __CG__;
kg              #eval{1.0/($rhog*$cg*$cg)};
kl              #eval{1.0/($rhol*$cl*$cl)};

// Pulse carrier frequency; also sets the radiation averaging window, which
// this study does not use: a short window keeps its stored fields small.
f               __F0__;
radiationAveragePeriods 0.1;

timeIntegrationMethod __TIME_METHOD__;
timeIntegrationTheta  __THETA__;
timeBlockLinearSolver __BLOCK_SOLVER__;
acousticDampingRate   0;

// Right-hand Cartesian PML of thickness L, read by setPMLFields.
PMLType         rectangle;
L               __PML_THICKNESS__;
sigmaMax        __SIGMA_MAX__;
po              __PML_ORDER__;
PMLMax          (__LENGTH__ 10 10);
PMLMin          (-10 -10 -10);
