FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticWaveFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         200e-3; // 2e-7; //50e-6;

deltaT          2e-7; //2e-8;//2e-9; 

writeControl    runTime; //timeStep;

writeInterval   4e-4; //1000; //5; //1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.25;

maxDeltaT       5e-6;

// ************************************************************************* //

functions
{
    ARFAverage
    {
        type            fieldAverage;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
//        enabled         false;
//                cleanRestart          true;
        writeControl   writeTime;
//        outputControl   outputTime;
//        outputInterval  1;
        fields
        (
            prT
            {
                mean            on;
                prime2Mean      off;
               base            time;
               windowType      approximate;
                window          #eval{5/40000};
                //windowName      movingAverageWindow;
                allowRestart    no;
            }

            momFluxT
            {
                mean            on;
                prime2Mean      off;
                base            time;
                windowType      approximate;
                window          #eval{5/40000};
                //windowName      movingAverageWindow;
                allowRestart    no;
            }

        );
    }

fieldsMinMax
{
    // Mandatory entries (unmodifiable)
    type        fieldMinMax;
    libs        (fieldFunctionObjects);

    // Mandatory entries (runtime modifiable)
    mode        magnitude;
    fields      (pa U);

    // Optional entries (runtime modifiable)
    location    no;
