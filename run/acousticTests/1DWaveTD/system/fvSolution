FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        // This required by calculating alphaf
        nAlphaCorr      2;

        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         0;
        clip            false;
        cAlpha          1;
        nAlphaSubCycles 1;
        advectionScheme isoAdvection;
        reconstructionScheme plicRDF;        
    }

    "p.*"
    {
        //solver          PCG;
        //preconditioner  DIC;
        solver           GAMG;
        smoother         DICGaussSeidel;
        tolerance       1e-12;
        relTol          0.01;
    }

    "U.*"
    {
        solver          diagonal;
    }

    "v.*"
    {
        solver          diagonal;
    }

    "u.*"
    {
//        solver          PBiCG;
//       preconditioner  DILU;
        solver          diagonal;//PCG;
//       preconditioner  DIC;
//        tolerance       1e-08;
//        relTol          0;
    }


}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors  4;
    nCorrectors       2;
    rhoMax            1.5;
}


