FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;
f   40000.0;
c0  343.0;
fac 4;
wL #eval{$fac*$c0/$f};

vertices
(
    (0 -0.0001 -0.0001)
    ($wL -0.0001 -0.0001)
    ($wL 0.0001 -0.0001)
    (0 0.0001 -0.0001)
    (0 -0.0001 0.0001)
    ($wL -0.0001 0.0001)
    ($wL 0.0001 0.0001)
    (0 0.0001 0.0001)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (#eval{$fac*400} 1 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }


    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

mergePatchPairs
(
);


