FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     acousticSPMLFoam;//rhoPimpleFoam;

startFrom       latestTime;//startTime;

startTime       0;

stopAt          endTime;//writeNow;//endTime;//writeNow;//endTime;

endTime         #eval{0.125/40000*100};

deltaT          1e-8;

writeControl    runTime;

writeInterval   #eval{0.125/40000};//1.32e-5;//0.0002;

purgeWrite      200;//10;

writeFormat     ascii;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.3;

maxDeltaT       1;

libs (
      "libOpenFOAM.so"
//      "libgroovyBC.so"
      "libsoundHarmonicVelocity.so"
      "libsoundHarmonicPressure.so"
      "libsoundPressureRadiation.so"
      "libsoundPressureSource.so"
     );

functions
{
	fieldsMinMax
	{
	    // Mandatory entries (unmodifiable)
	    type        fieldMinMax;
	    libs        (fieldFunctionObjects);

	    // Mandatory entries (runtime modifiable)
	    mode        magnitude;
	    fields      (p U);

	    // Optional entries (runtime modifiable)
	    location    no;
	}
}

