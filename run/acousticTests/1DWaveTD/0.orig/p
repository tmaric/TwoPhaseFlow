FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0]; // [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
             type            uniformFixedGradient;
             uniformGradient     cosine;
             uniformGradientCoeffs
          {
              frequency       constant 40000;
              scale           constant #eval{-1.2*2*pi()*40000};//411.6;
              level           constant 0;
          }
          value           $internalField;

    }
    outlet
    {
          type            zeroGradient;//acousticWaveTransmissive;
          //advectiveSpeed  343;
          value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}

