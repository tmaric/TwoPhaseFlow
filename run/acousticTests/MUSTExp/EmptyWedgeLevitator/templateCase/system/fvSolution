FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        // This required by calculating alphaf
        nAlphaCorr      2;

        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         0;
        clip            false;
        cAlpha          1;
        nAlphaSubCycles 1;
        advectionScheme isoAdvection;
        reconstructionScheme plicRDF;        
    }

    "p.*"
    {
          solver          GAMG; //PCG;
          smoother    DICGaussSeidel; //preconditioner  DIC;
          tolerance       1e-10;
          relTol          0.0;
    }

    "(U.*|v.*|u.*)"
    {
        solver          diagonal;
    }
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    2;
    nCorrectors         2;
     nNonOrthogonalCorrectors 2;
     residualControl
     {
         p
         {
                 tolerance  1e-10;
                 relTol     0.001;
         }
      }
}


relaxationFactors
{
/*    rho             1;
    p               0.3;
    U               0.7;
    T               0.7;
    k               0.7;
    epsilon         0.7;
    R               0.7;*/
     fields
     {
     }
     equations
     {
         ".*" 1;
     }
}


