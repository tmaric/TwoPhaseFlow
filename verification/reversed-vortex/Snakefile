# =============================================================================
# Reversed-vortex advection verification, with and without a superposed
# periodic Euclidean frame (Bothe & Maric).
#
#   materialize (local)  -> one OpenFOAM case per (scheme, frame, N)
#   solve       (sbatch) -> blockMesh | setAlphaField | generateUVortex2D | advectorVoF
#   aggregate   (local)  -> convergence.csv + convergence_table.tex
#   visualize   (sbatch) -> interface PNGs at t = 0, T/4, T/2, 3T/4, T via foamlib
#   plot_evolution       -> snapshots every 0.1T against the exact interface,
#                           and an animation of both runs side by side
#
# One sbatch per case; all cases run concurrently. Backends are selected with
# --workflow-profile only, exactly as in the leia workflow.
#
# WHY THE SNAPSHOTS HAVE THEIR OWN CASES. OpenFOAM's adjustableRunTime write
# control snaps the time step onto the write times, so the write interval is not
# a passive observer of the run: at N=128 with plicRDF, writing every T/4 rather
# than every T/2 moves the reported final error from 2.334e-3 to 2.151e-3, an 8%
# shift from output frequency alone. The convergence cases therefore keep the
# reference interval (T/2, reproducing the published testsuite errors) and the
# snapshots come from separate cases written every T/4. Snapshot cases never
# feed the table.
# =============================================================================
import os
import sys

WF = workflow.basedir
REPO = os.path.abspath(os.path.join(WF, "..", ".."))
sys.path.insert(0, os.path.join(WF, "scripts"))


configfile: os.path.join(WF, "config.yaml")


NS = [int(n) for n in config["resolutions"]]
SCHEMES = list(config["schemes"])
FRAMES = list(config["frames"])
RUNS = os.path.abspath(config.get("runs_dir", os.path.join(WF, "runs")))
RESULTS = os.path.abspath(config.get("results_dir", os.path.join(WF, "results")))
PREAMBLE = (config.get("env_preamble") or "").strip()
# Rank count per resolution. `np` may be a scalar (applied to every level) or a
# mapping N -> ranks, which is what lets one table span resolutions whose cost
# differs by three orders of magnitude while every case still clears the queue's
# wall-clock limit.
_np_cfg = config.get("np", 1)
if isinstance(_np_cfg, dict):
    _NP_BY_N = {int(k): int(v) for k, v in _np_cfg.items()}

    def ranks(N):
        return _NP_BY_N.get(int(N), 1)
else:
    _NP_CONST = int(_np_cfg)

    def ranks(N):
        return _NP_CONST


_LAUNCHER_TMPL = config.get("mpi_launcher", "mpirun -np {np}")


def launcher(N):
    return _LAUNCHER_TMPL.replace("{np}", str(ranks(N)))

TEMPLATE = os.path.join(REPO, "testsuite", "advection", "test-vortexShearedDisc")
RUN_CASE = os.path.join(WF, "scripts", "run_case.sh")

WRITE_INTERVAL = config["write_interval"]
VIZ_N = int(config["viz"]["N"])
VIZ_SCHEME = config["viz"]["scheme"]
VIZ_WI = config["viz"]["write_interval"]

# An environment *script* is preferred over `env_preamble` for anything that
# defines a variable and then uses it: snakemake expands $VARIABLES in config
# values against the submitting environment, so the later reference would be
# expanded to empty before the job ever runs. Sourcing a file defers expansion
# to the job's own shell.
ENV_SCRIPT = (config.get("env_script") or "").strip()
if ENV_SCRIPT and not os.path.isabs(ENV_SCRIPT):
    ENV_SCRIPT = os.path.join(WF, ENV_SCRIPT)

# Snakemake runs shell bodies under `bash -euo pipefail`. OpenFOAM's etc/bashrc
# reads unset variables (WM_PROJECT_DIR) and uses shell functions whose cleanup
# trips `-e`, so both flags are lifted across the environment setup and `-e` is
# restored for the rule body itself.
PRE = (
    "set +ue\n"
    + (f"source {ENV_SCRIPT}\n" if ENV_SCRIPT else "")
    + ((PREAMBLE + "\n") if PREAMBLE else "")
    + "set -e\n"
)

# The plotting job needs numpy/matplotlib/foamlib, NOT OpenFOAM. On a module
# system the OpenFOAM environment starts with `module purge`, which removes the
# python that carries those packages, so the snapshot rule gets its own
# environment. Empty by default: on a workstation the ambient python is fine.
VIZ_ENV_SCRIPT = (config.get("viz_env_script") or "").strip()
if VIZ_ENV_SCRIPT and not os.path.isabs(VIZ_ENV_SCRIPT):
    VIZ_ENV_SCRIPT = os.path.join(WF, VIZ_ENV_SCRIPT)

VIZ_PRE = (
    "set +ue\n"
    + (f"source {VIZ_ENV_SCRIPT}\n" if VIZ_ENV_SCRIPT else "")
    + "set -e\n"
)

ALL_CASES = [f"{s}_{f}_N{n}" for s in SCHEMES for f in FRAMES for n in NS]
VIZ_CASE = "viz_" + VIZ_SCHEME + "_{frame}_N" + str(VIZ_N)


wildcard_constraints:
    scheme="[A-Za-z]+",
    frame="[A-Za-z]+",
    N="[0-9]+",


ruleorder: materialize_viz > materialize
ruleorder: solve_viz > solve


rule all:
    input:
        os.path.join(RESULTS, "convergence.csv"),
        os.path.join(RESULTS, "convergence_table.tex"),
        os.path.join(RESULTS, "timestep_bound.json"),
        os.path.join(RESULTS, "courant_check.txt"),
        os.path.join(RESULTS, "frame_only_check.txt"),
        os.path.join(RESULTS, "convergence_shape_error.png"),
        os.path.join(RESULTS, "convergence_shape_error.pdf"),
        os.path.join(RESULTS, "frame_identity_check.txt"),
        os.path.join(RESULTS, "interface_moving_frame.png"),
        os.path.join(RESULTS, "interface_non_moving_frame.png"),
        os.path.join(RESULTS, "interface_evolution.png"),
        os.path.join(RESULTS, "interface_evolution.pdf"),
        os.path.join(RESULTS, "interface_evolution.gif"),


# -- the case-local flux generator, built once into FOAM_USER_APPBIN ----------
rule tools:
    output:
        touch(os.path.join(RUNS, ".tools.done")),
    shell:
        PRE + """
        cd {TEMPLATE}
        wmake generateUVortex2D
        command -v generateUVortex2D
        """

FIELD = "vortex"
SWIRL_ARG = "(0.5 0.5 0)"


# -- the time-step bound ------------------------------------------------------
# max||w||_1 over the domain and the period, from the same config values the
# cases are built from. build_case reads it from here; it is never copied by
# hand, which is how the 2D bound once drifted from the case it was meant for.
BOUND = os.path.join(RESULTS, "timestep_bound.json")


rule timestep_bound:
    output:
        BOUND,
    params:
        field=FIELD,
        end_time=config["end_time"],
        period=config["period"],
        revolutions=config["frame"]["revolutions"],
        translation=config["frame"]["translation_amplitude"],
        centre=config["frame"]["rotation_centre"],
        swirl=SWIRL_ARG,
        co=config["max_alpha_co"],
        ns=",".join(str(n) for n in NS),
        script=os.path.join(WF, "scripts", "timestep_bound.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} --field {params.field} \
            --end-time {params.end_time} --period {params.period} \
            --revolutions {params.revolutions} --translation {params.translation} \
            --centre "{params.centre}" --swirl "{params.swirl}" \
            --max-alpha-co {params.co} --resolutions {params.ns} --out {output}
        """


# -- the Courant number every run reached ------------------------------------
rule courant_check:
    input:
        expand(os.path.join(RUNS, "{case}", "volumeFractionError.dat"), case=ALL_CASES),
    output:
        os.path.join(RESULTS, "courant_check.txt"),
    params:
        runs=RUNS,
        cases=",".join(ALL_CASES),
        co=config["max_alpha_co"],
        script=os.path.join(WF, "scripts", "courant_check.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} --runs {params.runs} --cases {params.cases} \
            --max-alpha-co {params.co} --out {output}
        """


def _materialize(params, wildcards, output, write_interval, bound):
    import json
    import materialize

    materialize.build_case(
        template=params.template,
        case=params.case,
        scheme=params.scheme,
        frame=wildcards.frame,
        N=params.N,
        end_time=params.end_time,
        period=params.period,
        write_interval=write_interval,
        rotation_centre=params.centre,
        revolutions=params.revolutions,
        translation_amplitude=params.translation,
        np=params.np,
        max_alpha_co=params.max_alpha_co,
        u_max=json.load(open(bound))["u_max"],
    )
    open(output[0], "w").close()


# -- materialise one convergence case ----------------------------------------
rule materialize:
    input:
        tools=rules.tools.output,
        bound=BOUND,
    output:
        os.path.join(RUNS, "{scheme}_{frame}_N{N}", ".materialized"),
    params:
        template=TEMPLATE,
        case=lambda w: os.path.join(RUNS, f"{w.scheme}_{w.frame}_N{w.N}"),
        scheme=lambda w: w.scheme,
        N=lambda w: int(w.N),
        end_time=config["end_time"],
        period=config["period"],
        centre=config["frame"]["rotation_centre"],
        revolutions=config["frame"]["revolutions"],
        translation=config["frame"]["translation_amplitude"],
        np=lambda w: ranks(w.N),
        max_alpha_co=config["max_alpha_co"],
    run:
        _materialize(params, wildcards, output, WRITE_INTERVAL, input.bound)


# -- materialise one snapshot case (finer write interval) --------------------
rule materialize_viz:
    input:
        tools=rules.tools.output,
        bound=BOUND,
    output:
        os.path.join(RUNS, VIZ_CASE, ".materialized"),
    params:
        template=TEMPLATE,
        case=lambda w: os.path.join(
            RUNS, f"viz_{VIZ_SCHEME}_{w.frame}_N{VIZ_N}"
        ),
        scheme=VIZ_SCHEME,
        N=VIZ_N,
        end_time=config["end_time"],
        period=config["period"],
        centre=config["frame"]["rotation_centre"],
        revolutions=config["frame"]["revolutions"],
        translation=config["frame"]["translation_amplitude"],
        np=ranks(VIZ_N),
        max_alpha_co=config["max_alpha_co"],
    run:
        _materialize(params, wildcards, output, VIZ_WI, input.bound)


# -- run one convergence case ------------------------------------------------
rule solve:
    input:
        os.path.join(RUNS, "{scheme}_{frame}_N{N}", ".materialized"),
    output:
        os.path.join(RUNS, "{scheme}_{frame}_N{N}", "volumeFractionError.dat"),
    params:
        case=lambda w: os.path.join(RUNS, f"{w.scheme}_{w.frame}_N{w.N}"),
        np=lambda w: ranks(w.N),
        max_alpha_co=config["max_alpha_co"],
        launcher=lambda w: launcher(w.N),
        recon=0,
        runner=RUN_CASE,
    threads: 1
    resources:
        tasks=lambda w: ranks(w.N),
    shell:
        PRE + 'bash {params.runner} {params.case} {params.np} {params.recon} "{params.launcher}"'


# -- run one snapshot case ---------------------------------------------------
rule solve_viz:
    input:
        os.path.join(RUNS, VIZ_CASE, ".materialized"),
    output:
        os.path.join(RUNS, VIZ_CASE, "volumeFractionError.dat"),
    params:
        case=lambda w: os.path.join(RUNS, f"viz_{VIZ_SCHEME}_{w.frame}_N{VIZ_N}"),
        np=ranks(VIZ_N),
        max_alpha_co=config["max_alpha_co"],
        launcher=launcher(VIZ_N),
        recon=1,
        runner=RUN_CASE,
    threads: 1
    resources:
        tasks=ranks(VIZ_N),
    shell:
        PRE + 'bash {params.runner} {params.case} {params.np} {params.recon} "{params.launcher}"'


# -- convergence table -------------------------------------------------------
rule aggregate:
    input:
        expand(os.path.join(RUNS, "{case}", "volumeFractionError.dat"), case=ALL_CASES),
    output:
        csv=os.path.join(RESULTS, "convergence.csv"),
        tex=os.path.join(RESULTS, "convergence_table.tex"),
    params:
        runs=RUNS,
        schemes=SCHEMES,
        frames=FRAMES,
        ns=NS,
        end_time=config["end_time"],
    run:
        import aggregate

        aggregate.write(
            runs=params.runs,
            schemes=params.schemes,
            frames=params.frames,
            resolutions=params.ns,
            end_time=params.end_time,
            csv_path=output.csv,
            tex_path=output.tex,
        )


# -- interface snapshots via foamlib -----------------------------------------
rule visualize:
    input:
        framed=os.path.join(
            RUNS, f"viz_{VIZ_SCHEME}_frameA_N{VIZ_N}", "volumeFractionError.dat"
        ),
        plain=os.path.join(
            RUNS, f"viz_{VIZ_SCHEME}_none_N{VIZ_N}", "volumeFractionError.dat"
        ),
    output:
        moving=os.path.join(RESULTS, "interface_moving_frame.png"),
        static=os.path.join(RESULTS, "interface_non_moving_frame.png"),
    params:
        framed_case=os.path.join(RUNS, f"viz_{VIZ_SCHEME}_frameA_N{VIZ_N}"),
        plain_case=os.path.join(RUNS, f"viz_{VIZ_SCHEME}_none_N{VIZ_N}"),
        N=VIZ_N,
        scheme=VIZ_SCHEME,
        end_time=config["end_time"],
        centre=config["frame"]["rotation_centre"],
        revolutions=config["frame"]["revolutions"],
        script=os.path.join(WF, "scripts", "visualize.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} \
            --framed-case {params.framed_case} \
            --plain-case  {params.plain_case} \
            --n {params.N} --scheme {params.scheme} \
            --end-time {params.end_time} \
            --centre "{params.centre}" \
            --revolutions {params.revolutions} \
            --out-moving {output.moving} \
            --out-static {output.static}
        """

# -- interface evolution every 0.1T, and the animation -----------------------
# The recipe's marker figure redrawn from the solver output, with the exact
# interface computed independently underneath. Same two runs as the snapshots.
rule plot_evolution:
    input:
        framed=os.path.join(
            RUNS, f"viz_{VIZ_SCHEME}_frameA_N{VIZ_N}", "volumeFractionError.dat"
        ),
        plain=os.path.join(
            RUNS, f"viz_{VIZ_SCHEME}_none_N{VIZ_N}", "volumeFractionError.dat"
        ),
    output:
        png=os.path.join(RESULTS, "interface_evolution.png"),
        pdf=os.path.join(RESULTS, "interface_evolution.pdf"),
        gif=os.path.join(RESULTS, "interface_evolution.gif"),
    params:
        framed_case=os.path.join(RUNS, f"viz_{VIZ_SCHEME}_frameA_N{VIZ_N}"),
        plain_case=os.path.join(RUNS, f"viz_{VIZ_SCHEME}_none_N{VIZ_N}"),
        N=VIZ_N,
        scheme=VIZ_SCHEME,
        end_time=config["end_time"],
        period=config["period"],
        centre=config["frame"]["rotation_centre"],
        revolutions=config["frame"]["revolutions"],
        script=os.path.join(WF, "scripts", "plot_evolution.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} \
            --framed-case {params.framed_case} \
            --plain-case  {params.plain_case} \
            --n {params.N} --scheme {params.scheme} \
            --end-time {params.end_time} --period {params.period} \
            --centre "{params.centre}" \
            --revolutions {params.revolutions} \
            --out {output.png} --out-anim {output.gif}
        """


# -- code-path equivalence ---------------------------------------------------
# Section 4.2 of the manuscript claims that the moving-frame code path with the
# frame set to the identity reproduces the original retracing test.  That claim
# is checked here rather than by hand, so the number in the paper has the same
# provenance as the tables.
EQ_N = int(config.get("equivalence", {}).get("N", 128))
EQ_SCHEME = config.get("equivalence", {}).get("scheme", "plicRDF")


rule frame_identity:
    input:
        framed=os.path.join(
            RUNS, f"{EQ_SCHEME}_frameId_N{EQ_N}", "volumeFractionError.dat"
        ),
        plain=os.path.join(
            RUNS, f"{EQ_SCHEME}_none_N{EQ_N}", "volumeFractionError.dat"
        ),
    output:
        os.path.join(RESULTS, "frame_identity_check.txt"),
    params:
        end_time=config["end_time"],
        scheme=EQ_SCHEME,
        N=EQ_N,
        script=os.path.join(WF, "scripts", "frame_identity.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} \
            --framed {input.framed} --plain {input.plain} \
            --end-time {params.end_time} \
            --scheme {params.scheme} --n {params.N} \
            --out {output}
        """


# -- convergence figure ------------------------------------------------------
# In the workflow rather than a side script: the manuscript's convergence
# diagram must have the same provenance as its tables.
rule plot_convergence:
    input:
        csv=os.path.join(RESULTS, "convergence.csv"),
    output:
        png=os.path.join(RESULTS, "convergence_shape_error.png"),
        pdf=os.path.join(RESULTS, "convergence_shape_error.pdf"),
    params:
        script=os.path.join(WF, "scripts", "plot_convergence.py"),
        title="Reversed vortex, 2D",
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} --csv {input.csv} --out {output.png} \
            --title "{params.title}"
        """


# -- the error of the frame alone --------------------------------------------
# alpha = 0 leaves a solid-body revolution of the disc. Section 4.2 quotes its
# convergence; this rule is where those numbers come from.
FO_SCHEME = config.get("frame_only", {}).get("scheme", "plicRDF")
FO_NS = [int(n) for n in config.get("frame_only", {}).get("resolutions", [64, 128, 256])]


rule frame_only:
    input:
        expand(os.path.join(RUNS, FO_SCHEME + "_frameOnly_N{N}", "volumeFractionError.dat"),
               N=FO_NS),
    output:
        os.path.join(RESULTS, "frame_only_check.txt"),
    params:
        ns=",".join(str(n) for n in FO_NS),
        scheme=FO_SCHEME,
        end_time=config["end_time"],
        script=os.path.join(WF, "scripts", "frame_only.py"),
    threads: 1
    shell:
        VIZ_PRE + """
        python3 {params.script} --dat {input} --ns {params.ns} \
            --scheme {params.scheme} --end-time {params.end_time} --out {output}
        """
